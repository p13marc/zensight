[Unit]
Description=ZenSight hostspec — machine-checked desired-state assertions (#821)
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-hostspec --config /etc/zensight/hostspec.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# The least privileged sensor in the fleet: read-only observation of /proc,
# lstat/readlink, bounded file reads and /etc/passwd,group. It EXECUTES
# NOTHING (the assertion vocabulary is closed — no command/run kind), so the
# sandbox is total: transient user, read-only system, no capabilities.
#
# NOTE ProtectHome=read-only, not =yes: an operator asserting on a path under
# /home (a service user's dotfile, a deploy key) would otherwise read
# "unreadable" forever. Everything hostspec reads, it reads read-only anyway.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/zensight
CapabilityBoundingSet=

# ── The full sandbox block (#1204) ─────────────────────────────────────────
# Every line the sibling units carry, or a `sandbox-exception:` comment naming
# the one it cannot take and why. `scripts/packaging-check.sh` enforces that a
# unit has one or the other for each directive, so a line cannot go quietly
# missing again — which is how sixteen units shipped without this block for a
# year: they were written before the four newest, and nothing back-filled them.
# Nothing here costs hostspec anything: it reads /proc/self/mountinfo and
# /proc/net/tcp{,6} (both visible under ProtectProc=invisible), lstat/readlink,
# bounded file reads and /etc/passwd,group — and executes nothing.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=64M

[Install]
WantedBy=multi-user.target
