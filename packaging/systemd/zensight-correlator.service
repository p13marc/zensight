[Unit]
Description=ZenSight correlator — merge host evidence into the single-writer entity keyspace
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-correlator --config /etc/zensight/correlator.json5
Restart=on-failure
RestartSec=5s
# Graceful stop: SIGTERM lets the process drop its single-writer liveliness token
# before exit so a standby instance can take over cleanly.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# The operator-decision journal (#1102): link/unlink, ack and silence are the
# catalog's only non-derivable state, so they are written here to survive a
# restart. Under DynamicUser this resolves to
# /var/lib/private/zensight-correlator with a symlink at
# /var/lib/zensight-correlator, which is the path the shipped config names.
StateDirectory=zensight-correlator
StateDirectoryMode=0700
# Needs no capabilities: a pure bus client — it subscribes to evidence and
# publishes entities, binds nothing, and makes no privileged syscall.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
