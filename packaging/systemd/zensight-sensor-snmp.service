[Unit]
Description=ZenSight snmp — SNMP v1/v2c/v3 polling
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-snmp --config /etc/zensight/snmp.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
# SNMPv3 authoritative engine identity + boots counter (#650, RFC 3414 §2.2):
# /var/lib/zensight-snmp — the only writable path under ProtectSystem=strict.
# Without this the sensor cannot persist its engine id, so it refuses v3
# receiving (v1/v2c keeps working) rather than silently re-minting an identity
# every restart and breaking each inform sender until it rediscovers.
StateDirectory=zensight-snmp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Needs no capabilities as shipped: polling is outbound, and the trap
# listener is `enabled: false` in configs/snmp.json5.
#
# NOTE if you enable it: its shipped `bind` is 0.0.0.0:**162**, a privileged
# port. This unit cannot bind it — not because of the line below, but
# because it grants no AmbientCapabilities either. Enabling the trap
# listener on 162 means adding BOTH
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# exactly as zensight-sensor-logs does for syslog on 514 — or moving the
# listener to a port above 1024.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
