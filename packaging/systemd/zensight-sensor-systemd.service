[Unit]
Description=ZenSight systemd — unit/service state + boot performance
Documentation=https://github.com/p13marc/zensight
After=dbus.service
Wants=dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-systemd --config /etc/zensight/systemd.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Introspection over the system bus is read-only; run unprivileged under a
# transient system user with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Needs no capabilities: a system D-Bus client. Unit *control* (`actions`)
# is a separate, config-gated concern and goes through systemd's own
# authorisation, not through a capability held here.
CapabilityBoundingSet=

# ── The full sandbox block (#1204) ─────────────────────────────────────────
# Every line the sibling units carry, or a `sandbox-exception:` comment naming
# the one it cannot take and why. `scripts/packaging-check.sh` enforces that a
# unit has one or the other for each directive, so a line cannot go quietly
# missing again — which is how sixteen units shipped without this block for a
# year: they were written before the four newest, and nothing back-filled them.
# sandbox-exception: ProtectProc — the cgroup tree (`cgroup.rs`) attributes
# members by reading other processes' /proc/<pid> entries, which `invisible`
# hides; every unit would read as empty. /sys/fs/cgroup is read-only under
# ProtectControlGroups=yes, which is all this sensor needs of it. D-Bus is
# AF_UNIX.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
