[Unit]
Description=ZenSight otel — forward Zenoh telemetry to an OpenTelemetry (OTLP) collector
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-exporter-otel --config /etc/zensight/otel-exporter.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Needs no capabilities: a bus client with outbound OTLP egress. Outbound
# connections are unprivileged.
CapabilityBoundingSet=

# Sandbox (#1204). The four newest units (bmc/container/probe/pve) carried this
# block and the sixteen older ones did not — a difference worth four points of
# `systemd-analyze security` exposure that came from writing order, not from
# anything these processes require.
#
# It subscribes to the bus and makes OTLP requests. Both are AF_INET.
#
# If you build this binary with `--features zensight-common/linux-audit`
# (#957), add AF_NETLINK to RestrictAddressFamilies: the audit writer sends one
# AUDIT_USYS_CONFIG datagram per write-procedure outcome, and without the
# family it silently falls back to the `zensight::audit` tracing target.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
