[Unit]
Description=ZenSight logs — syslog (RFC 3164/5424) + journald ingestion
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-logs --config /etc/zensight/logs.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Bind the privileged syslog port (514) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# ── The full sandbox block (#1204) ─────────────────────────────────────────
# Every line the sibling units carry, or a `sandbox-exception:` comment naming
# the one it cannot take and why. `scripts/packaging-check.sh` enforces that a
# unit has one or the other for each directive, so a line cannot go quietly
# missing again — which is how sixteen units shipped without this block for a
# year: they were written before the four newest, and nothing back-filled them.
# Nothing here costs logs anything: the syslog listeners are AF_INET/AF_INET6
# (+ AF_UNIX for a socket listener and for the bus), the journal is read
# through libsystemd from /var/log/journal, and there is no JIT.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
