[Unit]
Description=ZenSight netlink — Linux kernel net telemetry (RTNETLINK/sock_diag)
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-netlink --config /etc/zensight/netlink.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run under a transient system user with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight

# DEMO POSTURE — "just run" with every collector enabled.
#
# The default reads (interfaces/routes/neighbors/addresses/sockets/ethtool/tc/
# diagnostics/RTNETLINK events/XFRM SA dump) are unprivileged and need NONE of
# the below. These capabilities unlock the *optional* collectors so a demo shows
# everything:
#   - CAP_NET_ADMIN → nftables + conntrack telemetry, and subscribing to the XFRM
#     monitor multicast groups (real-time IPsec lifecycle → events/ipsec/*).
#   - CAP_BPF (+ CAP_PERFMON for perf-based attach) → the eBPF module (#114).
#
# eBPF additionally requires a binary built with `--features ebpf` and
# `collect.ebpf = true`; the stock release binary ignores the BPF caps.
# (Ambient caps coexist with NoNewPrivileges=yes — systemd raises them at exec.)
# To return to the locked-down baseline, drop the three lines below.
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_PERFMON
# The eBPF tier (collect.ebpf, off by default) additionally needs
# CAP_DAC_READ_SEARCH: aya resolves a tracepoint by reading
# <tracefs>/events/<cat>/<name>/id, and /sys/kernel/tracing is 0700 root:root.
# Without it the two tracepoints fail to attach while the kprobes succeed —
# a half-attached module, which is worse than a clean refusal. It is left
# COMMENTED because it grants read access to any file on the host; uncomment
# only for an eBPF build, as zensight-sensor-sysinfo.service does.
# Note also that Debian/Ubuntu ship perf_event_paranoid=3, which denies the
# attach regardless of capabilities — see #683.
# AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH
# CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH
# Explicitly `no`, not omitted (#1204): the demo posture above grants the eBPF
# capabilities, and a tracing build writes to tracefs under /sys/kernel, which
# ProtectKernelTunables=yes would make read-only. The unprivileged baseline
# (drop the three capability lines) can take `yes`; every read this sensor
# makes — /proc/sys/net/netfilter/nf_conntrack_max included — works under
# either. Recorded here so the weaker value is a decision, not an accident.
ProtectKernelTunables=no

# ── The full sandbox block (#1204) ─────────────────────────────────────────
# Every line the sibling units carry, or a `sandbox-exception:` comment naming
# the one it cannot take and why. `scripts/packaging-check.sh` enforces that a
# unit has one or the other for each directive, so a line cannot go quietly
# missing again — which is how sixteen units shipped without this block for a
# year: they were written before the four newest, and nothing back-filled them.
# sandbox-exception: ProtectProc — the socket→process join reads other
# processes' /proc/<pid>/fd (one walk per `@rpc/netlink/sockets` query), which
# `invisible` hides. Without it every socket owner reads as "unknown".
# The eBPF tier (see the capability alternatives above) additionally needs
# bpf(2) and perf_event_open(2), which `@system-service` does not include, and
# the BPF loader maps program memory writable+executable. An eBPF build
# REPLACES the two lines marked below, as it replaces the capability lines:
#   SystemCallFilter=@system-service bpf perf_event_open
#   MemoryDenyWriteExecute=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
