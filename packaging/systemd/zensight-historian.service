[Unit]
Description=ZenSight historian — the fleet's telemetry history, ingest and range queries
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-historian --config /etc/zensight/historian.json5
Restart=on-failure
RestartSec=5s
# Graceful stop: SIGTERM lets the process take one last flush before exit, so
# the samples it has already accepted are not thrown away by a restart.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# The one thing the correlator does not need and this does: somewhere to put
# the database. systemd creates /var/lib/zensight-historian, chowns it to the
# transient user, and exports it as $STATE_DIRECTORY — which is where the
# config's `store.path: null` resolves to, so the unit and the shipped config
# agree without either naming a path.
StateDirectory=zensight-historian
# Needs no capabilities: a pure bus client — it subscribes telemetry, answers
# queries, binds nothing and makes no privileged syscall.
CapabilityBoundingSet=

# Sandbox (#1204). The four newest units (bmc/container/probe/pve) carried this
# block and the sixteen older ones did not — a difference worth four points of
# `systemd-analyze security` exposure that came from writing order, not from
# anything these processes require.
#
# It subscribes to `v1/*/telemetry/**`, writes its redb tiers under
# StateDirectory, and answers range queries. Disk plus sockets, nothing else.
#
# If you build this binary with `--features zensight-common/linux-audit`
# (#957), add AF_NETLINK to RestrictAddressFamilies: the audit writer sends one
# AUDIT_USYS_CONFIG datagram per write-procedure outcome, and without the
# family it silently falls back to the `zensight::audit` tracing target.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=320M

[Install]
WantedBy=multi-user.target
