[Unit]
Description=ZenSight prometheus — forward Zenoh telemetry to a Prometheus /metrics endpoint
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-exporter-prometheus --config /etc/zensight/prometheus-exporter.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Needs no capabilities: binds the scrape endpoint on 9464 (unprivileged;
# `prometheus.listen` in the shipped config). A port below 1024 would need
# CAP_NET_BIND_SERVICE here AND in the bounding set, as the logs unit does.
CapabilityBoundingSet=

# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
