[Unit]
Description=ZenSight sysinfo — host CPU / memory / disk / network metrics
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-sysinfo --config /etc/zensight/sysinfo.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
# Durable artifact chunk store (artifacts.snapshot.state_dir):
# /var/lib/zensight-sysinfo — the only writable path under ProtectSystem=strict.
StateDirectory=zensight-sysinfo
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight

# eBPF saturation histograms (issue #99) need a binary built with
# `--features ebpf`, plus CAP_BPF + CAP_PERFMON to load the tracing programs and
# CAP_DAC_READ_SEARCH to resolve a tracepoint id: aya reads
# <tracefs>/events/<cat>/<name>/id from userspace and /sys/kernel/tracing is mode
# 0700 root:root, so every attach fails EACCES without it — even with CAP_BPF.
# Note CAP_DAC_READ_SEARCH lets this unit read any file on the host; that is the
# price of the panel. Uncomment ONLY for an eBPF build; leave commented for the
# default unprivileged one. MemoryDenyWriteExecute would break the BPF loader, so an
# eBPF build sets it to `no` (see the sandbox block below).
#
# These three are necessary and NOT sufficient on Debian/Ubuntu: they ship
# kernel.perf_event_paranoid=3, above upstream's maximum of 2, which denies the
# attach whatever capabilities the unit holds. The programs load and every
# attach returns EACCES, so it reads as a capability problem and is not one.
# Needs kernel.perf_event_paranoid<=2 on the host — see #683 and
# zensight-sensor-sysinfo/docs/configuration.md.
# AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH
# CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH
# ProtectKernelTunables=no
#
# The SMART collector (#823, `collect.smart: true`) needs device access:
# CAP_SYS_ADMIN for the NVMe admin health-log ioctl, CAP_SYS_RAWIO for the
# ATA SG_IO pass-through, plus read access to /dev/nvme* and /dev/sd*
# (DeviceAllow / a `disk` supplementary group). Same rule as eBPF above:
# a SMART deployment REPLACES the capability lines, per arm it needs —
# NVMe-only hosts want only CAP_SYS_ADMIN.
# AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO
# CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO
#
# The default build needs no capabilities at all, so drop the whole set. This
# line and the commented one above are alternatives: an eBPF build replaces
# this with that, it does not add to it (#670). While it was commented out the
# bounding set stayed at the kernel default — the full set — which is what put
# this unit at 8.1 EXPOSED while its siblings sat at 5.6-5.9.
CapabilityBoundingSet=

# ── The full sandbox block (#1204) ─────────────────────────────────────────
# Every line the sibling units carry, or a `sandbox-exception:` comment naming
# the one it cannot take and why. `scripts/packaging-check.sh` enforces that a
# unit has one or the other for each directive, so a line cannot go quietly
# missing again — which is how sixteen units shipped without this block for a
# year: they were written before the four newest, and nothing back-filled them.
# sandbox-exception: ProtectProc — the process table, per-process CPU/RSS and
# the socket→process join all read other users' /proc/<pid>, which `invisible`
# hides. The two opt-in tiers REPLACE lines below, as they replace the
# capability lines above:
#   eBPF (--features ebpf) → the BPF loader maps program memory
#                            writable+executable, and bpf(2)/perf_event_open(2)
#                            are outside @system-service:
#                            MemoryDenyWriteExecute=no
#                            SystemCallFilter=@system-service bpf perf_event_open
#   SMART (collect.smart)  → /dev/nvme* and /dev/sd* are device nodes:
#                            PrivateDevices=no + DeviceAllow=block-* r
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
