[Unit]
Description=ZenSight sysinfo — host CPU / memory / disk / network metrics
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-sysinfo --config /etc/zensight/sysinfo.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
# Durable artifact chunk store (artifacts.snapshot.state_dir):
# /var/lib/zensight-sysinfo — the only writable path under ProtectSystem=strict.
StateDirectory=zensight-sysinfo
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight

# eBPF saturation histograms (issue #99) need a binary built with
# `--features ebpf`, plus CAP_BPF + CAP_PERFMON to load the tracing programs and
# CAP_DAC_READ_SEARCH to resolve a tracepoint id: aya reads
# <tracefs>/events/<cat>/<name>/id from userspace and /sys/kernel/tracing is mode
# 0700 root:root, so every attach fails EACCES without it — even with CAP_BPF.
# Note CAP_DAC_READ_SEARCH lets this unit read any file on the host; that is the
# price of the panel. Uncomment ONLY for an eBPF build; leave commented for the
# default unprivileged one. MemoryDenyWriteExecute would break the BPF JIT, so it
# must stay off (it is, here).
#
# These three are necessary and NOT sufficient on Debian/Ubuntu: they ship
# kernel.perf_event_paranoid=3, above upstream's maximum of 2, which denies the
# attach whatever capabilities the unit holds. The programs load and every
# attach returns EACCES, so it reads as a capability problem and is not one.
# Needs kernel.perf_event_paranoid<=2 on the host — see #683 and
# zensight-sensor-sysinfo/docs/configuration.md.
# AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH
# CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH
# ProtectKernelTunables=no
#
# The default build needs no capabilities at all, so drop the whole set. This
# line and the commented one above are alternatives: an eBPF build replaces
# this with that, it does not add to it (#670). While it was commented out the
# bounding set stayed at the kernel default — the full set — which is what put
# this unit at 8.1 EXPOSED while its siblings sat at 5.6-5.9.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
