[Unit]
Description=ZenSight modbus — Modbus TCP/RTU polling
Documentation=https://github.com/p13marc/zensight
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zensight-sensor-modbus --config /etc/zensight/modbus.json5
Restart=on-failure
RestartSec=5s
# Graceful stop (#161): SIGTERM lets the process publish its offline status and
# tombstone any firing alerts before exit.
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Needs no capabilities: a Modbus TCP client — outbound to port 502 only.
CapabilityBoundingSet=

# Sandbox (#1204). The four newest units (bmc/container/probe/pve) carried this
# block and the sixteen older ones did not — a difference worth four points of
# `systemd-analyze security` exposure that came from writing order, not from
# anything these processes require.
#
# Modbus TCP is AF_INET. **PrivateDevices is deliberately absent**: this sensor
# also speaks Modbus RTU over a serial port (`port: "/dev/ttyUSB0"`,
# `config.rs`), and a private /dev holds only null/zero/full/random/urandom/tty
# — the port would simply not be there, and an RTU deployment would start
# cleanly and read nothing. A TCP-only deployment can add `PrivateDevices=yes`;
# an RTU one wants `DeviceAllow=/dev/ttyUSB0 rw` instead.
# sandbox-exception: PrivateDevices — the RTU serial port is a device node,
# and the two deployments want opposite lines (above); the unit ships neither.
#
# If you build this binary with `--features zensight-common/linux-audit`
# (#957), add AF_NETLINK to RestrictAddressFamilies: the audit writer sends one
# AUDIT_USYS_CONFIG datagram per write-procedure outcome, and without the
# family it silently falls back to the `zensight::audit` tracing target.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The cgroup backstop (#812/#813/#1092). A STARTING POINT, not a measurement:
# measure yours with `just fleet-sizing`, which reads the health doc's
# self_stats. Keep it ABOVE this unit's `resources.budget_rss_mb` so the shed
# ladder gets to act before the kernel does — `scripts/packaging-check.sh`
# enforces that ordering, and that the quadlet beside this file agrees.
MemoryMax=64M

[Install]
WantedBy=multi-user.target
