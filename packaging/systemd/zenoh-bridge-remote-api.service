[Unit]
Description=zenoh remote-api bridge — a browser's way onto the ZenSight bus (#705)
Documentation=https://github.com/p13marc/zensight/blob/master/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# NOT a ZenSight binary: `cargo install zenoh-bridge-remote-api --version
# 1.10.1 --locked` (the workspace's zenoh version) puts it in ~/.cargo/bin;
# install it to /usr/local/bin. The standalone bridge, never `zenohd` plus
# a dynamic plugin — see the config's header for why (no stable Rust ABI).
#
# `-m client` because a unit-managed bridge sits beside a router, not the
# GUI. The mode is a CLI flag on this binary (it overrides the config's), so
# it lives here and not in the file. `-e` is set by the config's `connect`.
ExecStart=/usr/local/bin/zenoh-bridge-remote-api -c /etc/zensight/router-remote-api.json5 -m client --no-multicast-scouting
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=20s
# Run unprivileged under a transient system user, with a minimal sandbox.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/zensight
# Needs no capabilities: it binds one TCP port ≥ 1024 (the WebSocket, 10000
# by default) and dials the hub. Keep the WebSocket port above 1023 rather
# than granting CAP_NET_BIND_SERVICE — a reverse proxy owns 443.
CapabilityBoundingSet=

# Sandbox (#1204), the block every unit in this directory carries.
#
# AF_INET/AF_INET6 for zenoh and the WebSocket, AF_UNIX for a local router
# socket. The bridge opens the TLS material named in `secure_websocket` at
# start: put it under /etc/zensight/tls, readable by the dynamic user.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The cgroup backstop. A STARTING POINT, not a measurement: the bridge holds
# one native session per open browser tab and fans every subscribed sample
# through it, so its footprint is the sum of what the tabs watch — an H.264
# tier per tile is the expensive case. It publishes no health document
# (it is not a ZenSight producer), so `just fleet-sizing` cannot measure
# it; size it from `systemctl status` after a day of real use.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
