# ZenSight hostspec sensor — one container, one cgroup, its own budget (#813).
# MemoryMax below is a STARTING POINT (reference-fleet sizing); measure via
# the sensor's health doc self_stats and adjust. See README.md beside this.
[Unit]
Description=ZenSight hostspec sensor
After=network-online.target
Wants=network-online.target

[Container]
Image=git.marcpardo.eu/marcpardo/zensight-sensor-hostspec:latest
ContainerName=zensight-sensor-hostspec
Network=host
HostName=%H
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=/etc/zensight:/etc/zensight:ro

Environment=ZENSIGHT_ZENOH_CONNECT=tcp/127.0.0.1:7447
Exec=--config /etc/zensight/hostspec.json5

[Service]
Restart=on-failure
RestartSec=5s
MemoryMax=64M

[Install]
WantedBy=multi-user.target
