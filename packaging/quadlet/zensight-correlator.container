# ZenSight correlator — one container, one cgroup, its own budget (#813/#1093).
# MemoryMax below is a STARTING POINT (reference-fleet sizing); measure via the
# health doc's self_stats and adjust. See README.md beside this, and
# `packaging/README.md` for the units × capabilities × MemoryMax × budget table
# `scripts/packaging-check.sh` keeps true.
#
# ONE PER DEPLOYMENT, not one per host. It is the single writer of
# `@catalog/state/entity/*`; a second one on the same bus fights the first for
# every entity document.
#
# No health document yet, so `just fleet-sizing` has no row for this unit and
# the MemoryMax below cannot be measured the way a sensor's can — see #1202.
[Unit]
Description=ZenSight correlator
After=network-online.target
Wants=network-online.target

[Container]
Image=git.marcpardo.eu/marcpardo/zensight-correlator:latest
ContainerName=zensight-correlator
Network=host
HostName=%H
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=/etc/zensight:/etc/zensight:ro
# The operator's own decisions (merge/split, aliases). Without this an image
# pull discards them and the next pass re-derives whatever the evidence says.
Volume=zensight-correlator-state:/var/lib/zensight-correlator:Z
DropCapability=ALL
Environment=ZENSIGHT_ZENOH_CONNECT=tcp/127.0.0.1:7447
Environment=STATE_DIRECTORY=/var/lib/zensight-correlator
Exec=--config /etc/zensight/correlator.json5

[Service]
Restart=on-failure
RestartSec=5s
MemoryMax=128M

[Install]
WantedBy=multi-user.target
