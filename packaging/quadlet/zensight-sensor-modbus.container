# ZenSight modbus sensor — one container, one cgroup, its own budget (#813/#1093).
# MemoryMax below is a STARTING POINT (reference-fleet sizing); measure via the
# health doc's self_stats and adjust. See README.md beside this, and
# `packaging/README.md` for the units × capabilities × MemoryMax × budget table
# `scripts/packaging-check.sh` keeps true.
#
# A CLIENT ONLY, over Modbus TCP. Serial (RTU) is NOT usable in this form
# without passing the device through — add `AddDevice=/dev/ttyUSB0` and the
# matching group, or run the native unit, which is the better answer for a
# serial line.
[Unit]
Description=ZenSight modbus sensor
After=network-online.target
Wants=network-online.target

[Container]
Image=git.marcpardo.eu/marcpardo/zensight-sensor-modbus:latest
ContainerName=zensight-sensor-modbus
Network=host
HostName=%H
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=/etc/zensight:/etc/zensight:ro
DropCapability=ALL
Environment=ZENSIGHT_ZENOH_CONNECT=tcp/127.0.0.1:7447
Exec=--config /etc/zensight/modbus.json5

[Service]
Restart=on-failure
RestartSec=5s
MemoryMax=64M

[Install]
WantedBy=multi-user.target
