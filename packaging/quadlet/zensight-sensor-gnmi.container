# ZenSight gnmi sensor — one container, one cgroup, its own budget (#813/#1093).
# MemoryMax below is a STARTING POINT (reference-fleet sizing); measure via the
# health doc's self_stats and adjust. See README.md beside this, and
# `packaging/README.md` for the units × capabilities × MemoryMax × budget table
# `scripts/packaging-check.sh` keeps true.
#
# A CLIENT ONLY. It dials the gNMI targets its config names and listens for
# nothing, so it needs no capability and no host mount beyond its config —
# `DropCapability=ALL` below is the whole story.
[Unit]
Description=ZenSight gnmi sensor
After=network-online.target
Wants=network-online.target

[Container]
Image=git.marcpardo.eu/marcpardo/zensight-sensor-gnmi:latest
ContainerName=zensight-sensor-gnmi
Network=host
HostName=%H
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=/etc/zensight:/etc/zensight:ro
DropCapability=ALL
Environment=ZENSIGHT_ZENOH_CONNECT=tcp/127.0.0.1:7447
Exec=--config /etc/zensight/gnmi.json5

[Service]
Restart=on-failure
RestartSec=5s
MemoryMax=96M

[Install]
WantedBy=multi-user.target
