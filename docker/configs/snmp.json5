{
  // Docker-optimized configuration for zensight-sensor-snmp

  zenoh: {
    mode: "peer",
    // Connect to external Zenoh router/peers
    // connect: ["tcp/zenoh-router:7447"],
  },

  serialization: "json",

  snmp: {

    trap_listener: {
      enabled: true,
      bind: "0.0.0.0:162",
    },

    // Add your SNMP devices here
    devices: [
      // Example device configuration:
      // {
      //   name: "router01",
      //   address: "192.168.1.1:161",
      //   community: "public",
      //   version: "v2c",
      //   poll_interval_secs: 30,
      //   oids: [
      //     "1.3.6.1.2.1.1.1.0",   // sysDescr
      //     "1.3.6.1.2.1.1.3.0",   // sysUpTime
      //     "1.3.6.1.2.1.1.5.0",   // sysName
      //   ],
      //   walks: [
      //     "1.3.6.1.2.1.2.2.1",   // ifTable
      //   ],
      // },
    ],

    oid_groups: {
      system_info: {
        oids: [
          "1.3.6.1.2.1.1.1.0",
          "1.3.6.1.2.1.1.3.0",
          "1.3.6.1.2.1.1.5.0",
          "1.3.6.1.2.1.1.6.0",
        ],
        walks: [],
      },
      network_interfaces: {
        oids: [],
        walks: ["1.3.6.1.2.1.2.2.1"],
      },
    },

    // Metric names must be chunk-grammar-valid: each `/`-separated chunk is
    // lowercase alphanumeric plus `._-` (RFC 03 §2). Since #559 a violating
    // name is escaped losslessly at the publish boundary rather than rejected,
    // so a stale mixed-case name does not fail — it publishes as
    // `system/sys_x55_p_x54_ime`, a third spelling matching neither the old
    // names nor the built-ins, and warns once per name at startup. These match
    // the built-in tables and the shipped profiles.
    oid_names: {
      "1.3.6.1.2.1.1.1.0": "system/descr",
      "1.3.6.1.2.1.1.3.0": "system/uptime",
      "1.3.6.1.2.1.1.5.0": "system/name",
      "1.3.6.1.2.1.1.6.0": "system/location",
      "1.3.6.1.2.1.2.2.1.1": "if/{index}/index",
      "1.3.6.1.2.1.2.2.1.2": "if/{index}/descr",
      "1.3.6.1.2.1.2.2.1.8": "if/{index}/oper_status",
      "1.3.6.1.2.1.2.2.1.10": "if/{index}/in_octets",
      "1.3.6.1.2.1.2.2.1.16": "if/{index}/out_octets",
    },
  },

  logging: {
    level: "info",
  },
}
