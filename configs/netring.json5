{
  // Zenoh connection settings
  zenoh: { mode: "peer" },

  // On-demand artifact channel (@/artifact) — opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (clamped 256 KiB–1 MiB)
    },
    snapshot: {
      enabled: false,        // set true to allow directory downloads from this sensor
      dirs: [
        // { name: "pcaps", path: "/var/lib/netring/pcaps" },  // captured pcap set
      ],
      max_bytes: 268435456,  // 256 MiB cap on the (uncompressed) snapshot
      max_files: 50000,      // cap on the number of files in a snapshot
      cooldown_secs: 30,     // min gap between builds
      ttl_secs: 600,         // how long a built snapshot stays downloadable
      chunk_size: 262144,    // 256 KiB average (FastCDC content-defined chunking)
    },
  },

  // Tier-2 directory snapshots (@/artifact + @/store + @/tree) — opt-in. The
  // natural fit for netring: expose a captured-pcap directory for forensic pull
  // (content-addressed, dedup'd, restart-resumable). The operator picks a dir by
  // its logical `name`, never a raw path — `dirs` is the authorization boundary.

  // Netring sensor settings
  netring: {
    key_prefix: "zensight/netring",
    // Host identifier used as telemetry `source`. "auto" → hostname.
    source: "auto",
    // Capture backend (netring 0.28, #227): "auto" (default) probes + selects
    // (AF_XDP where available, else AF_PACKET) and logs/publishes the resolved
    // plan; "afpacket" forces AF_PACKET; "afxdp" needs an AF_XDP-enabled build
    // (falls back to auto here). The `pcap` setting below always overrides.
    backend: "auto",

    // Live capture interfaces (needs CAP_NET_RAW). Leave empty and set `pcap`
    // below to replay an offline capture instead (no privileges required).
    // Multiple interfaces are each captured per-NIC under AF_PACKET; unified
    // AF_XDP multi-NIC fan-in (#226) needs an AF_XDP-enabled build + CAP_IPC_LOCK
    // (host-only). A `capture-leg-asymmetry` alert fires if a flow's two
    // directions arrive on mismatched capture legs (tap miswire).
    interfaces: ["eth0"],
    // pcap: "/path/to/capture.pcap",

    collect: {
      bandwidth: true,   // per-application bytes/sec
      flows: true,       // flow lifecycle aggregates
      tcp_resets: true,  // TCP reset + connection-refused counters
      // TCP initiator inference (netring 0.28, #122): recover the true SYN
      // sender so flow/matrix/talkers are labelled client -> server regardless
      // of capture endpoint order. No-op cost when off. Default ON, TCP-only.
      infer_initiator: true,
      // L7 RED analytics (cleartext only). Enabled here so the GUI's DNS/HTTP
      // detail tabs (@/query/dns, @/query/http) work out of the box; without
      // these the sensor declares no DNS/HTTP queryable and a fetch returns
      // "No netring sensor responded".
      dns: true,         // DNS queries/rcodes/RTT + top SLDs (UDP/53)
      http: true,        // HTTP requests/status/latency + top hosts (TCP/80,8080)
      // L7 protocol visibility (netring 0.27, opt-in). Detail served on
      // @/query/quic and @/query/ssh; aggregate counts stream.
      quic: false,       // passive QUIC Initial JA4/SNI/ALPN/version + PQ (UDP/443)
      ssh: false,        // client+server HASSH + KEXINIT fingerprints (TCP/22)
      // Encrypted-DNS visibility (netring 0.29, #326): classify DoT/DoQ/DoH from
      // the TLS/QUIC handshake into streamed `dns/encrypted/*` counts + the
      // `@/query/encrypted_dns` inventory. Pairs with anomalies.encrypted_dns_bypass.
      encrypted_dns: false,
      // Reassemble IP fragments before L7 parsing so fragmented DNS / handshakes
      // still parse (netring 0.29, #326). Small buffering cost.
      ip_reassembly: false,
      // Flag cleartext SNMP v1/v2c community strings as anomalies. Needs the
      // sensor built with `--features snmp` (pulls the SNMP parser).
      snmp_cleartext: false,
      // Canonical IPFIX flow export (netring 0.28, #223). No-op unless built
      // with `--features ipfix`. Serves IANA-IE-keyed flow records on
      // @/query/ipfix (per-direction deltas IE 1/2, totals IE 85/86, precise
      // flowEndReason IE 136, Community ID) for SIEM / flow-collector consumers.
      ipfix: false,
      // Passive asset inventory (netring 0.27): discover hosts on the wire from
      // ARP / NDP / LLDP. Streams an `assets/discovered` count; the per-asset
      // detail (MAC / IP / hostname / platform / seen-via) is served on demand
      // via `@/query/assets`. Needs capture (CAP_NET_RAW).
      assets: true,
      // Also feed the inventory from CDP. Separate flag because CDP forces the
      // kernel prefilter to capture-all (it can't be expressed as a BPF term).
      asset_cdp: false,
    },
    bandwidth_period_secs: 5,

    // Wire-level bandwidth-by-process attribution (#318). OFF by default — this
    // opt-in tier joins netring's live per-flow wire bandwidth against the kernel
    // socket table via a periodic sock_diag dump + /proc fd scan, attributing
    // full-frame (wire-L2) throughput to owning processes. Best-effort: flows
    // whose socket isn't in the current dump land in an explicit `unattributed`
    // bucket. When on, per-process rows are served query-only on
    // `@/query/bandwidth` (refreshed every `bandwidth_period_secs`). Costs /proc
    // walks; leave off unless you want per-process wire attribution.
    bandwidth_attribution: false,

    // Passive-DNS name cache (#308). Observes DNS answers (CNAME-chain-resolved
    // A/AAAA claims under the queried name, PTR reverse claims, answer-TTL
    // expiry) into a bounded IP -> names map used to (a) enrich flow/talker
    // records with destination hostnames (`dst_names` / `names`) and (b) key the
    // `rita_beacon_fqdn` detector. Requires `collect.dns`; inert without it.
    names: {
      enabled: true,
      max_ips: 16384,           // LRU cap on distinct IPs tracked
      max_claims_per_ip: 8,     // provenance-tagged names kept per IP
      default_ttl_secs: 300,    // TTL for claims whose source carries none
      grace_secs: 60,           // added to every TTL before expiry
      batch_interval_secs: 10,  // new-mapping delta-feed drain cadence
      max_batch: 500,           // pending delta-feed cap between drains
    },

    // Host-evidence feed (#307): republish observed assets (`collect.assets`)
    // and passive-DNS name observations (`collect.dns` + `names`) as third-party
    // identity evidence on `zensight/_meta/evidence/**` for the correlator
    // (epic #312). Change-driven with a periodic liveness refresh; the per-tick
    // cap keeps a busy L2 segment from flooding the evidence bus.
    // NOTE: this feed is gated on its SOURCE collectors — asset evidence needs
    // `collect.assets`, name evidence needs `collect.dns`. With those off (the
    // shipped default) netring emits NO evidence even though `enabled` is true.
    evidence: {
      enabled: true,
      min_interval_secs: 60,   // floor between evidence drain ticks
      refresh_secs: 420,       // re-emit live claims at least this often (<= ttl/2)
      max_per_tick: 200,       // hard cap on evidence records emitted per tick
    },

    // Pillar A — network anomaly detectors.
    anomalies: {
      port_scan: true,   // TRW port-scan detection -> alerts

      // Encrypted-DNS bypass policy (#326, ATT&CK T1572): fire an
      // `encrypted_dns_bypass` anomaly when a DoT/DoQ/DoH session goes to a
      // resolver not on `dns_resolver_allowlist` (empty ⇒ fall back to netring's
      // known-public-resolver set). Needs collect.encrypted_dns.
      encrypted_dns_bypass: false,
      dns_resolver_allowlist: [],   // e.g. ["dns.google", "cloudflare-dns.com"]

      // FQDN-pivoted RITA beaconing (#308, ATT&CK T1071): robust Bowley+MAD
      // beacon statistics keyed by the destination's best forward DNS name
      // (from the `names` cache above) instead of the 5-tuple — catches C2
      // that rotates resolved IPs behind one domain. Shares
      // `rita_beacon_threshold` (default 0.9). Needs collect.dns + names.
      rita_beacon_fqdn: false,

      // Lateral movement (#123, ATT&CK T1021/T1558): SMB admin-share / IPC$
      // service-pipe access, RDP connection requests, Kerberos kerberoast /
      // weak-etype / brute-force. Build with `--features lateral` (pulls the
      // SMB/RDP/Kerberos parsers); a no-op when built without it.
      lateral_movement: false,

      // Data exfiltration (#123, ATT&CK T1048): flags a flow whose outbound
      // bytes exceed its per-source learned baseline by `exfil_sigma` stddevs
      // (and the `exfil_min_bytes` floor). Needs `collect.flows`.
      data_exfil: false,
      exfil_sigma: 4.0,
      exfil_min_bytes: 10485760, // 10 MiB outbound-byte floor
    },

    // Threat-intel detection (netring 0.27). Hits become alerts on @/alerts via
    // the same path as the detectors above.
    threat: {
      // Passive flow-risk scoring: obsolete TLS, cleartext HTTP credentials.
      flow_risk: true,
      // Indicator-of-compromise matching (bad IPs / domains / JA3 / JA4).
      ioc: {
        ips: [],          // e.g. ["203.0.113.6"] — matched against flow src/dst
        domains: [],      // e.g. ["evil.example"] — DNS qname / TLS SNI / HTTP Host
        ja4: [],          // bad JA4 client fingerprints
        ja3: [],          // bad JA3 client fingerprints
        files: [],        // newline IOC feeds (IP or domain per line, # comments)
      },
      // Sigma rule evaluation (build with `--features sigma`).
      sigma: { enabled: false, dir: null },
    },

    // Capture-overload detection (netring 0.27). Watches the windowed capture
    // drop-rate and raises/clears a `capture-overload` SensorHealth alert on the
    // debounced Normal<->Emergency transition. Needs `collect.capture_stats`.
    overload: {
      enabled: true,
      enter_drop_rate: 0.05,    // enter Emergency at 5% windowed drop rate
      recover_drop_rate: 0.01,  // recover below 1% ...
      recover_windows: 3,       // ... sustained for 3 calm windows (hysteresis)
      // Active load-shedding (netring 0.28, #224). Off by default: when on, the
      // sensor *deliberately* sheds new flows while in Emergency — honest,
      // counted drops (capture/<source>/shed/*) and a `shedding` label on the
      // capture-overload alert, instead of opaque kernel loss. Already-tracked
      // flows keep flowing (elephant-friendly).
      shed: {
        enabled: false,
        policy: "new_flows",    // "new_flows" (drop all new) | "sample"
        sample_rate: 0.5,       // for "sample": fraction of new flows to keep
      },
    },

    // Runtime capture-focus (netring 0.28, #225). Off by default. When enabled,
    // registers a reloadable packet-tier subscription whose filter can be
    // hot-swapped during an incident via `@/commands/capture_filter` (no capture
    // restart) to narrow attention to a host/port; `capture/focus/{packets,
    // bytes}` counters show the effect, and `@/status/capture_filter` reports the
    // live filter. Grammar: `tcp|udp|icmp`, `[src|dst] port N`, `[src|dst] host
    // IP`, `[src|dst] net CIDR`, combined with `and`/`or`/`!`/parens.
    capture_focus: {
      enabled: false,
      base_expr: "tcp or udp or icmp",
    },

    // On-demand packet capture over the unified `@/artifact` channel (#333).
    // Off by default. When `on_demand.enabled`, an operator can request a
    // bounded pcap from the GUI (or any client) — a dedicated reloadable
    // packet-tier tap streams frames to a `pcap[.zst]` file delivered as a
    // Tier-1 blob. Every request is clamped to the limits below (duration /
    // bytes / snaplen). NOTE: the packet tier only sees IP/L4 frames — non-IP
    // (ARP/LLDP) traffic is not captured. Arming the tap adds a permissive
    // build-time packet subscription (a per-frame predicate eval, like
    // capture_focus), so leave it off unless captures are actually needed.
    capture: {
      on_demand: {
        enabled: false,
        max_duration_secs: 300,     // hard cap; longer requests are clamped
        max_bytes: 268435456,       // 256 MiB; capture stops early (truncated)
        snaplen_max: 0,             // 0 = full frames allowed
        allow_filter: true,         // accept per-request narrowing filters
        cooldown_secs: 60,          // min gap between captures
        ttl_secs: 600,              // how long a finished capture stays fetchable
        chunk_size: 524288,         // 512 KiB blob-transfer chunk
      },

      // Continuous capture-to-disk (#327). Off by default. `rotating` spools
      // rotating pcap files to `dir` (local forensics; metadata only on the
      // bus); `triggered` keeps a bounded in-memory pre-trigger ring and, when
      // an anomaly at/above `trigger_min_severity` fires (or the GUI sends
      // `capture_now`), writes the lead-up + `post_trigger_secs` of aftermath
      // to a pcap served as a TTL'd blob artifact the GUI downloads.
      // MEMORY COST: `ring_bytes` of raw frames stays resident while triggered
      // mode is armed. A mode that is off at startup is not armed (no packet
      // subscription); switching between armed modes is live via
      // `@/commands/capture_disk`. Under systemd, add `ReadWritePaths=` for
      // `dir` to the unit.
      to_disk: {
        mode: "off",                     // "off" | "rotating" | "triggered"
        // dir: "/var/lib/zensight/captures",  // REQUIRED when mode != off
        ring_bytes: 33554432,            // 32 MiB pre-trigger ring (triggered)
        max_file_bytes: 67108864,        // 64 MiB per file (rotation / trigger cap)
        rotate_secs: 0,                  // 0 = size-based rotation only (rotating)
        max_files: 16,                   // retention: file count (oldest evicted)
        max_total_bytes: 1073741824,     // retention: 1 GiB total
        snaplen: 0,                      // 0 = full frames
        trigger_min_severity: "warning", // "info" | "warning" | "critical"
        trigger_kinds: [],               // detector slugs; empty = all anomalies
        post_trigger_secs: 10,           // aftermath recorded after the trigger
        compress: true,                  // zstd the finished trigger file
        artifact_ttl_secs: 3600,         // how long the blob stays downloadable
      },
    },
  },

  logging: { level: "info" },
}
