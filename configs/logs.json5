{
  // Logs sensor configured for local systemd-journald ingestion (used by
  // `just run`). For network syslog (UDP/TCP/Unix listeners) see syslog.json5.
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.

  },

  // Declared resource envelope (#811/#1091). `budget_rss_mb` arms two things
  // that do not exist without it: the `sensor-budget` alert at 80 % of this
  // number, and the shed ladder that tries to stay under it. A sensor with no
  // budget grows silently until the cgroup kills it — the 2026-08-17 sequence
  // `docs/ops/SIZING.md` is written about.
  //
  // A STARTING POINT, NOT A MEASUREMENT. 192 MiB is three quarters of this
  // unit's `MemoryMax=256M` — the same fraction the runner derives from a
  // cgroup when no budget is declared — so the ladder gets to shed before the
  // kernel gets to kill. Measure yours with `just fleet-sizing` and set it
  // from what you see; keep it BELOW `MemoryMax`.
  resources: {
    budget_rss_mb: 192,
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
    },
  },

  syslog: {

    // Override the agent-host source id (default: the local hostname).
    // source: "agent-host-01",

    // No network listeners — this instance reads the local journal only.
    listeners: [],

    // systemd-journald source (#57). Reads the local journal directly via
    // libsystemd (no `journalctl` subprocess).
    journald: {
      enabled: true,

      // Which journal to read. "system" = full host journal and the kernel;
      // needs journal-read access (add your user to the `systemd-journal`
      // group, or run as a system service). Use "user" for the per-user journal.
      scope: "system",

      // Only entries from launch onward. Use "cursor" for gap-free resume
      // across restarts (persists a cursor file), or "since" with `since`.
      start_from: "tail",

      // detect_events defaults to true: coredump / unit-failed / OOM journal
      // events (matched by MESSAGE_ID) are raised as alerts on state/logs/alert/*.

      // Self-exclusion (#625), on by default: entries whose _SYSTEMD_UNIT or
      // SYSLOG_IDENTIFIER starts with `zensight-sensor` are dropped in the
      // reader — the bundle tailing its own stdout is a feedback loop.
      // exclude_self: true,
      // Extra exact unit names to drop client-side (libsystemd has no
      // negative match); counted as journald/self_excluded_total.
      // exclude_units: ["noisy.service"],

      // Robustness under storms / rotation (#62). The reader feeds a bounded
      // channel; pick what happens when it fills:
      //   "drop_newest" (default) — shed + count incoming entries (bounded mem)
      //   "block"                 — backpressure the journal read (no loss, may lag)
      overflow: "drop_newest",
      // Optional global rate limit (entries/sec). Beyond it, keep 1-in-N and
      // count the rest as sampled-out so one screaming unit can't drown the bus.
      // max_eps: 5000,
      sample_ratio: 100,
      // Raise an ErrorReport once loss exceeds this fraction over a window (1%).
      drop_alert_ratio: 0.01,
    },

    // Derived rollup telemetry (#63): per-severity + per-unit (top-N) log rates,
    // error/warning rollups, units-in-failure, and journald throughput — emitted
    // every `derived_interval_secs` under zensight/v1/<origin>/telemetry/logs/*.
    derived: true,
    derived_interval_secs: 10,
    top_units: 10, // distinct per-unit series; the rest fold into `other`

    // SLO error-budget burn-rate alerting. The `error_ratio` / `burn_rate`
    // gauges are emitted regardless (cheap, bounded); `enabled` only controls
    // whether a `log-error-budget` alert is ever raised. Needs `derived`.
    error_budget: {
      enabled: false,
      target_ratio: 0.05,  // tolerated per-window error fraction (the SLO)
      burn_rate: 2.0,      // fire above target_ratio * burn_rate
      burn_windows: 3,     // consecutive over-budget windows (anti-flap)
    },

    // Durable per-line history (#544): a disk-backed redb store behind the hot
    // ring, so `@rpc/logs/events` serves days back (?from=;to=;after_uid=) across
    // restarts and server-side search (?pattern=;severity_min=;#553) has depth.
    // Off by default; `just run`'s demo profile turns it on.
    store: {
      enabled: false,
      path: null,             // null = $STATE_DIRECTORY / XDG state dir
      max_age_days: 7,        // prune by age
      max_records: 2000000,   // ...and by size, whichever first
      batch_size: 500,
      flush_interval_secs: 2,
      prune_interval_secs: 300,
      queue_capacity: 100000, // writer-channel bound; full → drop + count
      // redb page-cache budget in bytes (#625). redb's own default is 1 GiB,
      // which reads as a slow RSS climb toward OOM on small hosts.
      // cache_bytes: 67108864, // 64 MiB (the default)
    },

    // Log sentinel (#543): declarative pattern→alert rules, also managed at
    // runtime via @rpc/logs/rules/set. The 4 journald known-events ship as
    // built-in rules (they ride journald.detect_events). Add your own:
    //
    // This block SEEDS the ruleset. The same ruleset is authorable fleet-wide
    // on v1/@desired/state/<this-host>/logs/rules (#849); whichever writer
    // went last is visible on state/logs/applied/rules (source: file |
    // desired | rpc), and a DELETE of the desired key reverts this host to
    // exactly what is below. The sentinel runs whether or not this block has
    // rules, so a host with none still receives a fleet ruleset — and
    // @rpc/logs/rules answers rather than staying silent. A desired ruleset is
    // refused WHOLE if any regex fails to compile; a file one skips the rule
    // and warns, because here there is someone reading the warning.
    sentinel: {
      include_builtins: true,
      // Built-in kernel pattern rules (#824): EXT4-fs error, XFS corruption,
      // md/RAID disk failure, block-device I/O error — Critical, rate-limited,
      // source-agnostic (they need no journald). Off by default: enable them
      // on hosts whose disks you care about (i.e. enable them).
      include_kernel_builtins: false,
      rules: [
        // Example — fire a warning on repeated SSH auth failures (quiet unless
        // a brute-force is happening); pivots into the filtered Logs feed (#558):
        // {
        //   id: "sshd-bruteforce",
        //   match: { unit: "sshd.service", pattern: "Failed password" },
        //   threshold: { count: 5, within_secs: 60 },
        //   severity: "warning",
        //   summary: "SSH bruteforce on {host}: {count}× (e.g. {message})",
        //   // Optional cap on how often a rule may page (#824): at most
        //   // max_fires alert publications per per_secs; further fires are
        //   // suppressed and counted (visible in @rpc/logs/rules).
        //   rate_limit: { max_fires: 4, per_secs: 3600 },
        // },
        // Quoted lines are scrubbed before they leave the host: secret-looking
        // key=value assignments are replaced and the summary is suffixed
        // "(redacted)" — same denylist as the debug bundles.
      ],
    },

    // Filtered log-bundle export (#555): an on-demand zstd artifact of the lines
    // matching a filter (@rpc/logs/artifact/request kind=logbundle, over @blob).
    // Off by default; `just run`'s demo profile turns it on so the GUI Export /
    // `zenctl` path is exercisable.
    logbundle: {
      enabled: false,
      max_bytes: 67108864,    // 64 MiB
      max_lines: 1000000,
      cooldown_secs: 30,
      ttl_secs: 600,
      chunk_size: 524288,
    },

    // File tailing (#549) + TLS listener (#550) + observer evidence (#552) are
    // also available (see zensight-sensor-logs/docs/configuration.md). Not
    // enabled here: file tailing needs paths to watch, TLS needs certs, and
    // observer evidence needs network senders (this instance is journald-only).
  },

  logging: { level: "info" },

  // ───────────────────────────────────────────────────────────────────────
  // Threshold rules (#931) — numbers YOU chose, about metrics this sensor
  // publishes, evaluated on its own publish path and raised as alerts on
  // state/logs/alert/* like every other alert this sensor makes.
  //
  // Empty by default: this build ships no threshold that fires. The same set
  // is authorable fleet-wide on v1/@desired/state/<this-host>/logs/
  // thresholds and per-host over @rpc/logs/thresholds/set; whichever
  // wrote last is visible on state/logs/applied/thresholds
  // (source: file | desired | rpc).
  //
  // thresholds: {
  //   default_for_secs: 0,           // fire on the first violating sample
  //   default_recover_after_secs: 0, // resolve as soon as it is clear again
  //   rules: [
  //     {
  //       name: "ingest-loss",
  //       metric: "ingest/dropped_ratio",  // glob; `*` does not cross `/`
  //       // labels: { source: "*" },   // all label globs must match
  //       op: "GreaterThan",            // GreaterThan | GreaterOrEqual | LessThan
  //                                     // | LessOrEqual | Equal | NotEqual
  //       value: 0.01,
  //       clear: 0.001,                 // must cross back through this to resolve
  //       for_secs: 60,                 // continuously violated for this long
  //       recover_after_secs: 120,      // continuously clear for this long
  //       severity: "warning",
  //       summary: "{metric} is {value} on {source}",
  //     },
  //   ],
  // },

  // `@desired` fleet reconcile (#931): the kill switch lives HERE, in file
  // config, so the mechanism that could misbehave is disarmable from outside
  // itself.
  // desired: {
  //   enabled: true,
  //   refresh_secs: 300,   // storage re-GET cadence (the primary path)
  // },
}
