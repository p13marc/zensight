{
  // Zenoh connection settings
  zenoh: {
    // Mode: "client", "peer", or "router"
    mode: "peer",

    // OPTIONAL — the deployment base (#466), empty by default (no session
    // namespace; keys at the bus root). Set it — or ZENSIGHT_ZENOH_NAMESPACE —
    // to isolate this deployment on shared Zenoh infrastructure.
    // namespace: "my-deployment",

    // Endpoints to connect to (for client mode)
    // connect: ["tcp/localhost:7447"],

    // Endpoints to listen on (for peer/router mode)
    // listen: ["tcp/0.0.0.0:7448"],
  },

  // OpenTelemetry OTLP exporter settings
  opentelemetry: {
    // OTLP endpoint (gRPC default port: 4317, HTTP: 4318)
    endpoint: "http://localhost:4317",

    // Protocol: "grpc" or "http"
    //
    // Under "http" the per-signal path (/v1/metrics, /v1/logs, /v1/traces) is
    // appended to `endpoint` automatically. Do NOT append it yourself: one
    // field serves three signals, so a hand-appended /v1/metrics would fix
    // metrics and break logs and traces.
    protocol: "grpc",

    // Per-signal endpoint overrides (optional). Only needed for a split
    // backend — metrics to one collector, logs to another.
    // metrics_endpoint: "http://collector:4318/v1/metrics",
    // logs_endpoint: "https://logs.example.com/ingest",
    // traces_endpoint: "http://tempo:4318/v1/traces",

    // Export interval in seconds
    export_interval_secs: 10,

    // Export timeout in seconds
    timeout_secs: 30,

    // Export metrics (Counter, Gauge, Boolean values)
    export_metrics: true,

    // Export logs (Syslog text messages)
    export_logs: true,

    // Export sensor alerts (state/*/alert/*) as OTLP log events on the
    // "zensight.alerts" scope (severity mapped from the alert severity,
    // alert.* attributes). Set false to skip alert export.
    export_alerts: true,

    // Export the `events` class (#534) — SNMP traps, systemd unit failures —
    // as OTLP log records on the "zensight.events" scope.
    //
    // `events` is its own keyspace class, disjoint from both telemetry and
    // state, so neither of the subscribers above could ever see it: these
    // records reached the GUI and a Zenoh storage and never reached OTLP at
    // all (#762). Logs only — an append-only ULID-keyed stream on /metrics is
    // a cardinality explosion (#104).
    export_events: true,

    // Traces: alert lifecycles synthesized into OTLP spans (`alert:<rule>`),
    // one span per firing -> resolved transition.
    //
    // OFF by default, and deliberately so: ZenSight propagates no W3C trace
    // context across sensors, so these spans are DERIVED, not observed. Each is
    // a single parentless span with an id hashed from the alert key and its
    // firing timestamp. There is no service graph and no waterfall, and only a
    // RESOLVED alert produces a span at all — an alert that is still firing
    // shows nothing.
    //
    // Worth turning on for a Tempo demo ("how long was this alert firing", flap
    // patterns) as long as that is understood. `gen-configs.sh --exporters`
    // turns it on for the demo-max profile; the key is spelled out here, rather
    // than left to the Rust default, because that script can only flip a key
    // that really exists in this file (see its header).
    traces: {
      enabled: false,
    },

    // How host identity reaches the OTLP Resource (#755).
    //
    //   "per-origin" (default) — one Resource per observed host, carrying
    //       host.id (the RFC 06 minted origin), host.name and
    //       service.instance.id. This is what OTel semconv expects, and the
    //       only shape that works for LOGS: a backend derives stream identity
    //       from the resource, so a shared one collapses the whole fleet into
    //       a single log stream.
    //
    //   "flat" — one shared Resource, host identity carried as data-point and
    //       log-record attributes instead. For backends that cope badly with
    //       many resources. Metrics stay queryable; logs lose per-host streams.
    //
    // resource_mode: "per-origin",

    // Cap on distinct per-host resources. Each owns its own signal providers,
    // so this bounds memory and pipelines; past it, further hosts share the
    // flat resource and are counted rather than growing without limit.
    // max_resources: 512,

    // Service name for OTEL resource. Under per-origin the producer is
    // appended, so a netlink sensor reports `zensight.netlink`.
    service_name: "zensight",

    // Service version (optional)
    // service_version: "1.0.0",

    // Headers for authentication (optional).
    //
    // These reach the exporter now (#756) — they were parsed and then never
    // used, so every authenticated backend got a 401 with no hint why. An
    // https:// endpoint also works now; TLS was never enabled at the crate
    // level, so it used to kill the process at startup.
    // headers: {
    //   "Authorization": "Bearer your-token-here",
    // },

    // Additional resource attributes
    resource: {
      // "deployment.environment": "production",
      // "service.namespace": "monitoring",
    },
  },

  // Telemetry filtering (optional)
  filters: {
    // Zenoh subscription key expression for telemetry
    // (default "v1/*/telemetry/**" — the v1 class selector, base-RELATIVE:
    // since #466 the deployment base is the session *namespace*, not a key
    // chunk, so a "zensight/"-prefixed selector here matches NOTHING).
    // Narrow it to tame the firehose at the subscription — unwanted protocols
    // and the state/media planes never reach this exporter over the wire.
    // The state/*/alert/* subscriber is separate and unaffected.
    // key_expr: "v1/*/telemetry/netring/**",

    // Only include these protocols (empty = all)
    // include_protocols: ["snmp", "sysinfo", "logs"],

    // Exclude these protocols
    // exclude_protocols: [],

    // Only include these sources (empty = all)
    // include_sources: ["router01", "server01"],

    // Exclude these sources
    // exclude_sources: ["test-device"],
  },

  // Logging configuration
  logging: {
    // Log level: "trace", "debug", "info", "warn", "error"
    level: "info",

    // Log format: "text" or "json"
    format: "text",
  },
}
