{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.

  },

  // Declared resource envelope (#811/#1091). `budget_rss_mb` arms two things
  // that do not exist without it: the `sensor-budget` alert at 80 % of this
  // number, and the shed ladder that tries to stay under it. A sensor with no
  // budget grows silently until the cgroup kills it — the 2026-08-17 sequence
  // `docs/ops/SIZING.md` is written about.
  //
  // A STARTING POINT, NOT A MEASUREMENT. 384 MiB is three quarters of this
  // unit's `MemoryMax=512M` — the same fraction the runner derives from a
  // cgroup when no budget is declared — so the ladder gets to shed before the
  // kernel gets to kill. Measure yours with `just fleet-sizing` and set it
  // from what you see; keep it BELOW `MemoryMax`.
  resources: {
    budget_rss_mb: 384,
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle from the GUI.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
    },
  },

  // Parallax video sensor settings
  parallax: {
    source: "auto",       // host id used as the `source` key chunk; "auto" detects the hostname

    // Advertise local V4L2 cameras (/dev/video*) in the stream catalogue.
    // Headless hosts simply contribute nothing.
    enumerate_v4l2: true,

    // Camera discovery (#410). ABSENT = NO DISCOVERY, EVER — the block's
    // presence is the opt-in, as for snmp.discovery (#541).
    //
    // What it finds is PROPOSED on state/parallax/discovery with a
    // copy-pasteable rtsp[] snippet, and nothing else: a discovered camera
    // never enters the catalogue, gets no liveliness token, and is never
    // captured, encoded or published. There is no auto_add and there will not
    // be one — a monitoring system that starts pulling video off hardware
    // nobody configured has done something categorically different from
    // noticing that it exists.
    //
    // mDNS is multicast on a network you may not own, and it is traffic an IDS
    // can flag. Keep it to networks you operate.
    // discovery: {
    //   mdns: true,           // browse _rtsp._tcp
    //   ws_discovery: true,   // ONVIF WS-Discovery Probe (each probe named
    //                         //   explicitly: enabling the block turns on
    //                         //   nothing you did not ask for)
    //   browse_secs: 10,      // how long one round listens
    //   interval_secs: 3600,  // between rounds
    // },

    // Remote RTSP cameras. Each entry becomes one catalogue stream.
    rtsp: [
      // { name: "door", url: "rtsp://cam.local:554/stream1",
      //   username: "viewer", password: "secret", description: "front door" },
    ],

    // Synthetic test-pattern sources — same catalogue/command/encode/egress
    // path as real cameras (demo mirrors the contract). The default entry
    // lets the sensor stream on any machine, camera or not.
    // Patterns: smpte / checkerboard / ball / gradient / snow / solid /
    // black / white.
    test_sources: [
      { name: "test0", pattern: "smpte", width: 640, height: 360, fps: 15 },
    ],

    // JPEG preview profile (@media/<stream>/preview/jpeg): low-fps thumbnails
    // for the GUI tile grid.
    preview: {
      fps: 2,            // preview frame rate (thumbnails, not video)
      quality: 75,       // JPEG quality 1-100
      max_height: 360,   // aspect-preserving cap; a 1080p camera's thumbnail is
                         // otherwise a 1080p JPEG (~30x the pixels a tile needs).
                         // null = source size.
    },

    // H.264 video (@media/<stream>/video/h264/<tier>): a bandwidth tier ladder.
    // Each tier is published concurrently on its own <tier> key; a viewer
    // subscribes to the tier its link can take, so two viewers on different
    // links never fight over one encoder. The sensor owns the numbers; the
    // wire and the key carry the name.
    video: {
      gop_frames: 60,          // keyframe (IDR) interval in frames (shared default)
      default_tier: "medium",  // the tier an open with no explicit tier gets

      // Encoder shaping shared by every tier (#509); a tier's own `encoder`
      // block overrides any field. Every knob below is COMMENTED OUT on
      // purpose: unset means the corresponding parallax builder is never
      // called, so the encoder keeps OpenH264's own default rather than a
      // number this file guessed. Sensor-local — none of it is on the wire.
      encoder: {
        // profile: "baseline",   // baseline / main / high. All three are
        //                        // verified to decode through the GUI's own
        //                        // OpenH264 decoder; unset lets the codec pick.
        // complexity: "medium",  // low / medium / high — CPU per frame. Reach
        //                        // for "low" when `encoder_overrun` fires:
        //                        // cheaper than dropping resolution, and
        //                        // invisible to the receiver.
        // usage_type: "camera_realtime",  // camera_/screen_ × realtime or not.
        //                        // A property of the SOURCE, so set it here
        //                        // rather than per tier.
        // qp: 26,                // 0..=51; under Bitrate rate control with
        //                        // frame skipping on, the controller works in
        //                        // a ±4 band around it.
        // gop_frames: 30,        // per-tier override of the shared GOP above.
        // max_slice_len: 1200,   // cap each NAL near the path MTU. OFF, and
        //                        // note it buys nothing *here*: this sensor
        //                        // publishes a whole access unit as ONE
        //                        // best-effort Zenoh sample, so losing a
        //                        // sample loses the whole AU whether it was
        //                        // one slice or twenty. Set it when an RTP or
        //                        // WebRTC payloader is downstream.
      },

      tiers: [
        { name: "low",    max_height: 240,  fps: 10, bitrate_kbps: 400  },
        { name: "medium", max_height: 480,  fps: 20, bitrate_kbps: 1200 },
        { name: "high",   max_height: null, fps: 30, bitrate_kbps: 4000 },  // null = native
      ],
    },

    // Tear an open profile down after this many seconds with no viewers and
    // no explicit opens (crash backstop for GUIs that die without CloseStream).
    idle_timeout_secs: 30,

    // Interval between per-stream stats telemetry points
    // (fps/kbps/drops/rc_drops/viewers/encode_ms).
    stats_interval_secs: 5,
  },

  // Logging configuration
  logging: {
    level: "info",     // trace, debug, info, warn, error
    format: "text",    // text or json
  },

  // ───────────────────────────────────────────────────────────────────────
  // Threshold rules (#931) — numbers YOU chose, about metrics this sensor
  // publishes, evaluated on its own publish path and raised as alerts on
  // state/parallax/alert/*.
  //
  // Empty by default: this build ships no threshold that fires. The same set
  // is authorable fleet-wide on v1/@desired/state/<this-host>/parallax/
  // thresholds and per-host over @rpc/parallax/thresholds/set; whichever
  // wrote last is visible on state/parallax/applied/thresholds
  // (source: file | desired | rpc).
  //
  // thresholds: {
  //   default_for_secs: 0,           // fire on the first violating sample
  //   default_recover_after_secs: 0, // resolve as soon as it is clear again
  //   rules: [
  //     {
  //       name: "encoder-backlog",
  //       metric: "stream/*/queue_depth",  // glob; `*` does not cross `/`
  //       // labels: { source: "*" },  // all label globs must match
  //       op: "GreaterThan",            // GreaterThan | GreaterOrEqual | LessThan
  //                                     // | LessOrEqual | Equal | NotEqual
  //       value: 30.0,
  //       clear: 10.0,                 // must cross back through this to resolve
  //       for_secs: 60,                 // continuously violated for this long
  //       recover_after_secs: 120,      // continuously clear for this long
  //       severity: "warning",
  //       summary: "{metric} is {value} on {source}",
  //     },
  //   ],
  // },

  // `@desired` fleet reconcile (#931): the kill switch lives HERE, in file
  // config, so the mechanism that could misbehave is disarmable from outside
  // itself.
  // desired: {
  //   enabled: true,
  //   refresh_secs: 300,   // storage re-GET cadence (the primary path)
  // },
}
