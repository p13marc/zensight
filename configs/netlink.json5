{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.

  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
      // redact_extra: ["my_custom_secret_field"],  // extra field-name patterns
    },
  },

  // Netlink sensor settings
  netlink: {
    source: "auto",     // host id used as telemetry `source`; "auto" detects the hostname
    poll_interval_secs: 2,
    collect: {
      interfaces: true,
      sockets: true,
      neighbors: true,   // ARP/NDP neighbor state summary
      routes: true,      // routing-table summary
      diagnostics: true, // bottleneck score + issue counts
      events: true,      // real-time RTNETLINK event stream (#8)
      ethtool: true,     // link speed/duplex, ring sizes, drops (#9)
      addresses: true,   // IP address inventory (#10)
      tc: true,          // TC/QoS qdisc drops/overlimits/backlog (#12) — drives the TC panel
      // Temporarily OFF: nlink's XFRM dump requests trip a ratelimited kernel
      // warning ("netlink: 224 bytes leftover after parsing attributes") on every
      // poll — cosmetic but noisy in the demo. Re-enable once nlink ships the fix
      // (https://github.com/p13marc/nlink/issues/160). Also gates the XFRM monitor
      // event stream. Empty without IPsec anyway. (#13)
      xfrm: false,       // IPsec/xfrm SA + policy health
      // The two below need CAP_NET_ADMIN (granted in the demo systemd unit) —
      // enable on a firewall / NAT gateway:
      nftables: true,    // nftables table/chain/rule counters (#14)
      conntrack: true,   // conntrack table summary
      // Opt-in eBPF module (#114) — connect-latency gauges + retransmit
      // attribution (@rpc/netlink/retransmits) + tcplife records (@rpc/netlink/connections).
      // Needs a binary built with `--features ebpf` (nightly + bpf-linker) AND
      // CAP_BPF + CAP_PERFMON (+ CAP_DAC_READ_SEARCH to resolve a tracepoint id
      // under a 0700 tracefs). No-op otherwise. Off by default.
      //
      // Validated on a host (6.12.101+deb13, 2026-08-19, #168): the programs
      // load, both tracepoints attach, connect latency now tracks the real
      // handshake (checked against netem at 100 ms and 5 ms RTT) and pid/comm
      // attribution is exact (110/110 on a curl loop that previously scored
      // 59/91). Retransmit peers agree with `nstat TcpRetransSegs`.
      //
      // The byte/segment gap is closed (#681): tcplife's counters are read
      // from `struct tcp_sock` using offsets the sensor resolves from the
      // running kernel's BTF and injects at load time, CO-RE being unavailable
      // to rustc/bpf-linker. On a kernel whose BTF does not expose them the
      // counters stay zero and `counters_measured` is false, so "not measured"
      // is now sayable rather than indistinguishable from "idle". `just run`
      // still leaves this tier off by default; sysinfo's eBPF histograms are
      // the ones the demo turns on. See the module docs in
      // zensight-sensor-netlink-ebpf/src/main.rs.
      ebpf: false,
      // Socket→process attribution for the socket drill-down (#304): one
      // /proc/<pid>/fd walk per @rpc/netlink/sockets query joins each socket to its
      // owning process (pid/comm/start_time) and resolves the cgroup v2 path.
      // Unprivileged: other users' processes are skipped unless the sensor
      // runs privileged. On by default; toggle at runtime like any collector.
      socket_processes: true,
      // Skip the /proc walk (reply unattributed) above this many processes —
      // a query-time cost ceiling for very busy hosts.
      socket_process_max_procs: 4096,
    },
    // Opt-in eBPF module tuning (#114). Only used when collect.ebpf is set.
    ebpf: {
      conn_ring_capacity: 256, // recent-connections ring (@rpc/netlink/connections)
      retransmit_top_k: 20,    // top peers returned by @rpc/netlink/retransmits
    },
    interfaces: {
      exclude_loopback: false,
      exclude_virtual: false,
    },

    // Host-evidence feed (#307): republish valid ARP/NDP neighbors as
    // third-party identity evidence on `…/state/netlink/evidence/**` for the
    // correlator (epic #312). Change-driven with a periodic liveness refresh;
    // the neighbor poll drives it but `min_interval_secs` floors the rate.
    evidence: {
      enabled: true,
      min_interval_secs: 60,   // floor between evidence feed runs
      refresh_secs: 420,       // re-emit live claims at least this often (<= ttl/2)
      max_per_tick: 200,       // hard cap on evidence records emitted per run
    },

    // Pillar B — declared expectations for THIS host (sentinel). The sensor
    // evaluates these and emits alerts (state/netlink/alert/*) on
    // deviation, auto-resolving when satisfied again. Expectations added live
    // from the GUI (Expectations view) are merged with these.
    //
    // This block SEEDS the set. The same set is authorable fleet-wide on
    // v1/@desired/state/<this-host>/netlink/expectations (#849) and per-host
    // over @rpc/netlink/expectations/set; whichever wrote last is visible on
    // state/netlink/applied/expectations (source: file | desired | rpc), and a
    // DELETE of the desired key reverts this host to exactly what is below.
    // The kill switch is the `desired` block further down, in FILE config.
    expectations: {
      eval_interval_secs: 3,
      default_for_secs: 3,         // debounce: violated continuously for N s
      // Recovery hold (#932): satisfied continuously for N s before the alert
      // resolves. 0 (the default) resolves on the first clear sweep. Every
      // expectation below may override it with `recover_after_secs`.
      // default_recover_after_secs: 0,
      sockets: [
        // Security baseline: nothing should be listening on telnet. Safe on a
        // clean host (won't false-fire), demonstrates a forbid_listen rule.
        { name: "no-telnet", forbid_listen: 23, severity: "critical" },

        // Demo: a service that should be listening but (intentionally) isn't —
        // this FIRES on `just run` so you can see the alert pipeline end to end.
        // Change the port to a real service (e.g. 22 for sshd) for a live check.
        { name: "demo-expected-service", listen: 65000, severity: "warning" },
      ],
      // links: [
      //   { iface: "eth0", up: true, severity: "critical" },
      // ],
      // Policy-routing rule expectations (#323). `forbid` (default) fires on
      // any non-baseline `ip rule` matching the optional priority/table
      // selectors (the kernel's 0/32766/32767 lookup rules never count) —
      // the traffic-diversion guard; `require` fires when the matching rule
      // is missing (pin a VPN/mark rule). Re-evaluated instantly on
      // NewRule/DelRule events; violations are tagged ATT&CK T1599.
      // rules: [
      //   { name: "no-diversion", sense: "forbid", severity: "critical" },
      //   { name: "vpn-rule", sense: "require", priority: 100, table: 51820 },
      // ],
    },
  },

  logging: { level: "info" },

  // ───────────────────────────────────────────────────────────────────────
  // Threshold rules (#931) — numbers YOU chose, about metrics this sensor
  // publishes, evaluated on its own publish path and raised as alerts on
  // state/netlink/alert/*.
  //
  // Empty by default: this build ships no threshold that fires. The same set
  // is authorable fleet-wide on v1/@desired/state/<this-host>/netlink/
  // thresholds and per-host over @rpc/netlink/thresholds/set; whichever
  // wrote last is visible on state/netlink/applied/thresholds
  // (source: file | desired | rpc).
  //
  // thresholds: {
  //   default_for_secs: 0,           // fire on the first violating sample
  //   default_recover_after_secs: 0, // resolve as soon as it is clear again
  //   rules: [
  //     {
  //       name: "conntrack-full",
  //       metric: "conntrack/usage_ratio",  // glob; `*` does not cross `/`
  //       // labels: { source: "*" },  // all label globs must match
  //       op: "GreaterThan",            // GreaterThan | GreaterOrEqual | LessThan
  //                                     // | LessOrEqual | Equal | NotEqual
  //       value: 0.9,
  //       clear: 0.8,                 // must cross back through this to resolve
  //       for_secs: 60,                 // continuously violated for this long
  //       recover_after_secs: 120,      // continuously clear for this long
  //       severity: "warning",
  //       summary: "{metric} is {value} on {source}",
  //     },
  //   ],
  // },

  // `@desired` fleet reconcile (#931): the kill switch lives HERE, in file
  // config, so the mechanism that could misbehave is disarmable from outside
  // itself.
  // desired: {
  //   enabled: true,
  //   refresh_secs: 300,   // storage re-GET cadence (the primary path)
  // },
}
