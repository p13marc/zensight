{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.
                    // "client", "peer", or "router"
    // connect: ["tcp/localhost:7447"], // Router endpoints (if client mode)

    // OPTIONAL — TLS material for `tls/…` endpoints (e.g. a zenohd router
    // behind mTLS). Field names mirror Zenoh's transport/link/tls keys; each
    // is also overridable via ZENSIGHT_ZENOH_TLS_{CA,CERT,KEY,MTLS}.
    // tls: {
    //   root_ca_certificate: "/etc/zensight/tls/ca.crt",
    //   connect_certificate: "/etc/zensight/tls/host.crt",  // mTLS only
    //   connect_private_key: "/etc/zensight/tls/host.key",  // mTLS only
    //   enable_mtls: true,
    // },
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
    },
    snapshot: {
      enabled: false,        // set true to allow directory downloads from this sensor
      dirs: [
        // { name: "etc", path: "/etc" },              // example: a /etc snapshot
        // { name: "pcaps", path: "/var/lib/netring" }, // example: captured pcaps
      ],
      max_bytes: 268435456,  // 256 MiB cap on the (uncompressed) snapshot
      max_files: 50000,      // cap on the number of files in a snapshot
      cooldown_secs: 30,     // min gap between builds
      ttl_secs: 600,         // how long a built snapshot stays downloadable
      chunk_size: 262144,    // 256 KiB average (FastCDC content-defined chunking)
    },
  },

  // Tier-2 directory snapshots (@rpc artifact/request + @blob/store + @blob/tree) — opt-in. When
  // enabled, an operator can download a whole allowlisted directory tree from the
  // GUI (content-addressed + dedup'd + restart-resumable). The operator picks a
  // directory by its logical `name`, never an arbitrary path — `dirs` is the
  // authorization boundary. A netring sensor would point one of these at its pcap
  // capture output dir; here it ships disabled with no directories.

  // System information collection settings
  sysinfo: {

    // Source id (hostname) for key expressions
    // Use "auto" to detect the local hostname automatically, or specify a custom name
    source: "auto",

    // Poll interval in seconds
    poll_interval_secs: 5,

    // Which metrics to collect
    collect: {
      // CPU usage (global and per-core)
      cpu: true,

      // Memory usage (RAM and swap)
      memory: true,

      // Disk usage (per mount point)
      disk: true,

      // Network statistics (per interface)
      network: true,

      // System info (uptime, load averages)
      system: true,

      // hwmon temperature sensors, per chip/label, with their critical/max trip
      // points (sensors/{chip}/{label}/{temp,critical,max}). Linux + hwmon only;
      // reads are unprivileged. No sensors => nothing published.
      // Required by alerts.thermal below, which grades against the trip points —
      // enable both together.
      temperatures: false,

      // TCP connection-state counts (ESTABLISHED, TIME_WAIT, ...) from
      // /proc/net/tcp. Linux-only; a missing file is skipped gracefully.
      tcp_states: false,

      // cgroup-v2 container saturation: CPU throttling, memory limit/OOM kills,
      // per-cgroup pressure. Reads /sys/fs/cgroup for the sensor's own cgroup
      // plus anything in cgroup_paths. No cgroup-v2 => skipped gracefully.
      cgroups: false,

      // Thermal/power depth: hwmon fan RPM (sensors/{chip}/{label}/rpm), battery
      // capacity/status, kernel entropy pool, and RAPL energy->watts.
      // Hardware-specific and higher-cardinality; missing hardware is skipped
      // gracefully. NOTE the RAPL arm reads /sys/class/powercap/*/energy_uj,
      // which is root-only on most distros (CVE-2020-8694): an unprivileged
      // sensor still reports fans/battery/entropy, but no watts.
      power: false,

      // Top processes by CPU/memory (can be resource-intensive)
      processes: false,

      // Number of top processes to report (if processes: true)
      top_processes: 10,

      // eBPF saturation histograms (issue #99) — OFF by default.
      // Requires a binary built with `--features ebpf` (nightly + rust-src +
      // bpf-linker) AND, at runtime, CAP_BPF + CAP_PERFMON to load the tracing
      // programs, plus CAP_DAC_READ_SEARCH because aya resolves a tracepoint by
      // reading <tracefs>/events/<cat>/<name>/id and /sys/kernel/tracing is mode
      // 0700. A rootless container cannot load BPF at all (the kernel checks the
      // initial user namespace), whatever capabilities are set.
      // Serves runqlat (scheduler run-queue latency) and biolatency (block-I/O
      // latency) log2 histograms on @rpc/sysinfo/latency — never streamed.
      // Ignored (graceful, baseline unaffected) if any prerequisite is missing:
      // the queryable is still declared and replies `available: false`, so the
      // GUI distinguishes "not built with eBPF" from "no sensor answered".
      // `just run` flips this on automatically when it built an eBPF binary.
      ebpf: false,
    },

    // Process-explorer privacy (#302): argv values whose key looks secret
    // (password, *_token, api_key, ...) are scrubbed before cmdlines leave the
    // host — even on the query channel. Scrubbing is ON by default.
    processes: {
      scrub_args: true,              // false = publish raw argv (trusted env only)
      // custom_sensitive_words: ["*_key_file"],  // extra keys, "*" globs allowed
      strip_proc_arguments: false,   // true = publish no arguments at all
    },

    // Network interface filtering
    network: {
      // Only include these interfaces (empty = include all)
      include: [],

      // Exclude these interfaces
      exclude: [],

      // Exclude loopback interface (lo)
      exclude_loopback: true,

      // Exclude virtual interfaces (docker*, veth*, br-*, virbr*, vnet*)
      exclude_virtual: false,
    },

    // Disk mount point filtering
    disk: {
      // Only include these mount points (empty = include all)
      include: [],

      // Exclude these mount points
      exclude: [],

      // Exclude pseudo filesystems (tmpfs, sysfs, proc, etc.)
      exclude_pseudo: true,
    },

    // hwmon chip filtering for collect.temperatures and collect.power's fans.
    sensors: {
      // hwmon chip names (/sys/class/hwmon/hwmon*/name) to skip entirely.
      // Exact, case-sensitive; empty = collect every chip.
      // Some boards expose one physical embedded controller through two drivers
      // — Dell laptops carry both the modern `dell_ddv` and the legacy
      // `dell_smm`, reporting identical temperatures and fans, one labelled and
      // one not. Name the redundant chip here to publish each reading once.
      exclude_chips: [],
    },

    // Threshold-based alerting. Each poll tick the already-collected saturation
    // data is graded against these thresholds and firing/resolved alerts are
    // published on state/sysinfo/alert/* (same channel as the other
    // sensors; the GUI picks them up with no extra wiring). All values below are
    // the built-in defaults — the whole `alerts` block is optional.
    alerts: {
      // Master switch for all sysinfo alerting.
      enabled: true,

      // "Must be violated continuously for N seconds" debounce before a firing
      // alert is published (0 = publish on first violation).
      for_secs: 0,

      // New OOM kills since the last poll (memory/oom_kills_total delta > 0).
      // Always Critical.
      oom: { enabled: true },

      // PSI some/avg10 per resource: Warning at *_warn, Critical at *_critical.
      // Needs collect.pressure (on by default). Memory is graded harder.
      pressure: {
        enabled: true,
        cpu_warn: 40, cpu_critical: 70,
        memory_warn: 10, memory_critical: 30,
        io_warn: 40, io_critical: 70,
      },

      // Disk space hi-watermark per mount (Warning/Critical %). Needs collect.disk.
      disk: { enabled: true, warn_percent: 90, critical_percent: 95 },

      // Inode hi-watermark per mount. Needs collect.fd_inode (on by default).
      inode: { enabled: true, warn_percent: 90, critical_percent: 95 },

      // File-descriptor table occupancy (fs.file-nr / fs.file-max). Warning only.
      fd: { enabled: true, warn_percent: 80 },

      // Thermal: Critical when temp >= fraction * critical trip point.
      // OFF by default — requires collect.temperatures: true (which provides the
      // critical trip points). Enable both together.
      thermal: { enabled: false, fraction: 0.9 },

      // Swap thrash: Warning when (pswpin + pswpout) exceeds the page rate.
      // Needs collect.vmstat (on by default). 1000 pages/s ~= 4 MiB/s.
      swap: { enabled: true, warn_pages_per_sec: 1000 },
    },
  },

  // Logging
  logging: {
    level: "info",                   // "trace", "debug", "info", "warn", "error"
  },
}
