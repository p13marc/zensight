{
  // Zenoh connection settings
  zenoh: {
    // Mode: "client", "peer", or "router"
    mode: "peer",

    // OPTIONAL — the deployment base (#466), empty by default (no session
    // namespace; keys at the bus root). Set it — or ZENSIGHT_ZENOH_NAMESPACE —
    // to isolate this deployment on shared Zenoh infrastructure.
    // namespace: "my-deployment",

    // Endpoints to connect to (for client mode)
    // connect: ["tcp/localhost:7447"],

    // Endpoints to listen on (for peer/router mode)
    // listen: ["tcp/0.0.0.0:7448"],

    // OPTIONAL — TLS material for `tls/…` endpoints (e.g. a zenohd router
    // behind mTLS). Field names mirror Zenoh's transport/link/tls keys; each
    // is also overridable via ZENSIGHT_ZENOH_TLS_{CA,CERT,KEY,MTLS}.
    // tls: {
    //   root_ca_certificate: "/etc/zensight/tls/ca.crt",
    //   connect_certificate: "/etc/zensight/tls/correlator.crt",  // mTLS only
    //   connect_private_key: "/etc/zensight/tls/correlator.key",  // mTLS only
    //   enable_mtls: true,
    // },
  },

  // Wire serialization for the entity docs this service publishes: "json" or "cbor".
  serialization: "cbor",

  // How long (seconds) a HostEvidence claim is trusted after its last refresh.
  // Claims older than this are ignored by the merge rules and age out of the
  // entity view. Sensors refresh live claims every 60s (sensor-core's
  // registration/evidence loop), so 900s tolerates a dozen missed refreshes.
  evidence_ttl_secs: 900,

  // Debounce (ms) between an evidence change and a recompute, so a burst of
  // arriving evidence collapses into one merge pass.
  recompute_debounce_ms: 500,

  // The longest (ms) a recompute may be deferred, however busy the bus. The
  // debounce above is an IDLE gap, and a fleet's inbound stream — evidence
  // refreshes, a passive-DNS observation per resolved IP, every alert
  // transition, ack, silence and liveliness flap — may never go idle for
  // 500 ms. Without this cap the deadline slid forward on every message and
  // the catalog simply stopped recomputing, while the `reemit_secs` pass below
  // kept republishing the frozen set with a fresh `last_updated` (#1106).
  // 0 disables the cap and restores the pure debounce.
  recompute_max_wait_ms: 2000,

  // How often (seconds) to re-emit every current entity. Doubles as correlator
  // liveness and lets a restarting frontend reseed from the AdvancedPublisher
  // cache. The frontend marks an entity stale after ~3x this period.
  reemit_secs: 60,

  // Identity merge rules (kill-switches). host_id is the strongest join and
  // effectively never wrong; hostname is the weakest and most false-merge prone,
  // so disable it on networks with duplicate hostnames.
  rules: {
    host_id: true,        // sha256(machine-id) equal  -> confidence 1.0
    cloud_instance: true, // same cloud (provider, instance_id) -> confidence 0.95 (#311)
    mac_ip: true,         // shared MAC AND shared IP   -> confidence 0.8
    fqdn: true,           // equal FQDN                 -> confidence 0.5
    hostname_enabled: true, // equal hostname           -> confidence 0.25
  },

  // Operator identity assertions — `@catalog/@rpc/link` / `unlink` (#473,
  // RFC 06 §5.4).
  //
  //   zenctl service call @catalog "" link --param old=h-<12hex> --param new=h-<12hex>
  //
  // A reinstall (new machine-id, same box) mints a NEW origin while the old
  // one's evidence is still live. The correlator refuses to merge them, and it
  // is right to: it cannot tell a reinstall from two machines. Only an operator
  // can, and this is how they say so. `unlink` is the undo.
  //
  // OFF by default, because `link` overrides the one guard standing between the
  // catalog and fusing two real hosts into one. When off, both procedures still
  // reply `error/gated` rather than timing out — an operator finds out the
  // feature exists and is disabled.
  allow_operator_assertions: false,

  // Incidents (#900): group the fleet's firing alerts by ENTITY, attribute
  // each group to a root cause over the relationship graph, and publish
  // @catalog/state/incident/*. One incident per machine, whether its own
  // sensor, a hypervisor polling it or a prober noticed — which is the thing
  // grouping by `source` could never do.
  //
  // ON by default, unlike allow_operator_assertions, and the difference is the
  // point: assertions let an operator override the guard against fusing two
  // real machines, so they wait to be chosen. Incidents only read — they group
  // alerts that already exist and publish a conclusion, exactly as entity and
  // edge documents do, and turning them off makes the fleet's triage surface
  // silently absent rather than safe.
  //
  // The switch is here so the mechanism that could misbehave is disarmable
  // from outside itself: an incident pass that churns should be stoppable
  // without stopping the catalog.
  // incidents_enabled: true,

  // Logging configuration
  logging: {
    // Log level: "trace", "debug", "info", "warn", "error"
    level: "info",

    // Log format: "text" or "json"
    format: "text",
  },
}
