{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.
                    // "client", "peer", or "router"
    // connect: ["tcp/localhost:7447"], // Router endpoints (if client mode)
    serialization: "cbor",           // "json" or "cbor"
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,
      ttl_secs: 600,
      chunk_size: 524288,
    },
  },

  // systemd sensor settings
  systemd: {

    // How often to read the systemd Manager (seconds)
    poll_interval_secs: 15,

    // Telemetry source id; defaults to the local hostname when omitted.
    // source: "gw01",

    // Per-unit telemetry watchlist (#273): globs of units to stream
    // unit/<name>/* for. Empty = none (only aggregates). Capped by watch_max.
    watch_units: [],           // e.g. ["sshd.service", "nginx*.service", "*.timer"]
    watch_max: 50,
    ip_io_accounting: false,   // include ip/io bytes when the unit enables accounting

    events_capacity: 256,      // control-plane event ring size (#275, @rpc/systemd/events)

    // Built-in threshold alerts (#276) → state/systemd/alert/*.
    alerts: {
      enabled: true,
      for_secs: 15,            // debounce before a firing alert publishes
      unit_failed: true,       // watched unit ActiveState=failed (see logs-sensor dedup)
      system_degraded: true,   // SystemState=degraded / NFailedUnits>0
      restart_storm_threshold: 3,
      restart_storm_window_secs: 300,
      unit_mem_ceiling_bytes: 0,   // 0 disables the unit-mem rule
      timer_overdue_grace_secs: 300,
      // Consecutive failed *runs* of a watched unit (#824): restart_storm's
      // logic where NRestarts cannot see — a timer-triggered oneshot never
      // restarts, each trigger is a fresh run (counted by InvocationID,
      // judged by Service.Result). 0 disables.
      consecutive_failures_threshold: 3,
    },

    // cgroup-tree query (#280) — served on demand at @rpc/systemd/cgroups[?path=<rel>];
    // never streamed. Unprivileged /sys/fs/cgroup v2 walk, depth/breadth capped.
    cgroup: { root: "system.slice", max_depth: 6, max_children: 64, max_pids: 32 },

    // Embedded sentinel (#277) — declarative expectations → state/systemd/alert/*,
    // hot-swappable via @rpc/systemd/expectations/set. This block SEEDS the set;
    // the sentinel itself runs whenever alerting is on, so a host with no block
    // still receives a set authored fleet-wide on @desired (#849). Omit it to
    // start empty; `alerts.enabled: false` turns the sentinel off.
    // expectations: {
    //   eval_interval_secs: 10,
    //   for_secs: 15,
    //   services_active: [{ unit: "sshd.service" }],
    //   targets_active: [{ target: "multi-user.target" }],
    //   // Two timer strengths (#824): `within_secs` proves the timer FIRED;
    //   // `succeeded_within_secs` proves it fired AND its service's last run
    //   // SUCCEEDED — the form that catches a timer firing on schedule while
    //   // its service fails every run. Either or both per timer.
    //   timers: [{ timer: "logrotate.timer", within_secs: 90000 },
    //            { timer: "cosign.timer", succeeded_within_secs: 3900 }],
    //   restart_rates: [{ unit: "nginx.service", max: 5, window_secs: 600 }],
    //   forbid_failed: true,
    // },

    // To watch this work without arming a real unit, use the #866 demo lever:
    //   sudo scripts/demo-actions.sh install   # inert unit + one-unit polkit rule
    //   just actions=1 run
    // When it refuses, the capability answer now carries a `reason` naming the
    // switch and this file, so a greyed-out button explains itself.
    //
    // Gated service control (#283) — DEFAULT OFF. Destructive + privileged; the
    // sensor is strictly read-only unless this is explicitly enabled with an
    // allowlist. Authorization is enforced by systemd/polkit (run as root, or add
    // a scoped polkit rule granting org.freedesktop.systemd1.manage-units for the
    // allowlisted units). @rpc/systemd/action/set {verb,unit} → @rpc/systemd/action.
    // actions: {
    //   enabled: false,
    //   allow_units: ["nginx.service", "app-*.service"],
    //   job_timeout_secs: 30,
    //
    //   // enable/disable write symlinks under /etc that survive a reboot, and
    //   // need the manage-unit-files polkit action rather than manage-units —
    //   // so granting start/stop does not silently grant them.
    //   allow_unit_files: false,
    //   // daemon-reload is manager-wide: it names no unit, so allow_units
    //   // cannot scope it and this switch is its only gate. Needs the
    //   // reload-daemon polkit action.
    //   allow_daemon_reload: false,
    //
    //   history_capacity: 64,   // audit ring served on @rpc/systemd/actions
    //
    //   // Serve unit-file contents on @rpc/systemd/unit/file. A *read* surface,
    //   // independent of `enabled`. Off by default because unit files routinely
    //   // carry credentials in Environment= lines; secret-looking assignments
    //   // are redacted and the reply is capped, but that is a denylist, not a
    //   // proof. Review your unit files before turning this on.
    //   expose_unit_files: false,
    // },

    collect: {
      // Enumerate units (ListUnits) for units/{total,active,failed,loaded,inactive}.
      // Turn off to only collect the cheap manager/* scalars + boot timings.
      list_units: true,
      // Boot-performance phase durations (boot/*_usec), like systemd-analyze.
      boot: true,
      // Mount/automount state aggregates mounts/{total,mounted,failed} (#279).
      mounts: false,
      // Journal store health journal/{disk_usage_bytes,disk_available_bytes} (#279).
      journal: false,
    },
  },

  // `@desired` fleet reconcile (#849): this sensor's expectation set can be
  // authored fleet-wide under v1/@desired/state/<this-host>/systemd/
  // expectations (LWW, storage-backed; see docs/KEYSPACE.md) — the same seam
  // hostspec has had since #816. The kill switch lives HERE, in file config,
  // so the mechanism is disarmable from outside itself. The applied set is
  // visible on state/systemd/applied/expectations (source: file|desired|rpc),
  // which is also what says which writer won last when an operator's
  // @rpc/systemd/expectations/set races a desired publish.
  // desired: {
  //   enabled: true,
  //   refresh_secs: 300,   // storage re-GET cadence (the primary path)
  // },

  // Logging
  logging: {
    level: "info",
  },

  // ───────────────────────────────────────────────────────────────────────
  // Threshold rules (#931) — numbers YOU chose, about metrics this sensor
  // publishes, evaluated on its own publish path and raised as alerts on
  // state/systemd/alert/* like every other alert this sensor makes.
  //
  // Empty by default: this build ships no threshold that fires. The same set
  // is authorable fleet-wide on v1/@desired/state/<this-host>/systemd/
  // thresholds and per-host over @rpc/systemd/thresholds/set; whichever
  // wrote last is visible on state/systemd/applied/thresholds
  // (source: file | desired | rpc).
  //
  // thresholds: {
  //   default_for_secs: 0,           // fire on the first violating sample
  //   default_recover_after_secs: 0, // resolve as soon as it is clear again
  //   rules: [
  //     {
  //       name: "restart-storm",
  //       metric: "unit/*/restarts",  // glob; `*` does not cross `/`
  //       // labels: { source: "*" },   // all label globs must match
  //       op: "GreaterThan",            // GreaterThan | GreaterOrEqual | LessThan
  //                                     // | LessOrEqual | Equal | NotEqual
  //       value: 5.0,
  //       clear: 1.0,                 // must cross back through this to resolve
  //       for_secs: 60,                 // continuously violated for this long
  //       recover_after_secs: 120,      // continuously clear for this long
  //       severity: "warning",
  //       summary: "{metric} is {value} on {source}",
  //     },
  //   ],
  // },


}
