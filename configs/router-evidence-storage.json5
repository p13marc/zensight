// zenohd (router) configuration that makes the ZenSight v1 STATE plane durable
// (RFC 09 §2): one LWW "latest" storage over the fleet state selector, plus an
// explicit "catalog" storage for the @catalog service origin (`*` never matches
// the verbatim `@catalog` chunk — D4). Together they double as the fleet-wide
// late-joiner seed: a GET on any state selector is answered by the router even
// when producers sleep (RFC 05 §4).
//
//   zenohd -c configs/router-evidence-storage.json5
//
// Requires the storage-manager + filesystem-backend plugins (shipped with a
// standard zenohd build): zenoh-plugin-storage-manager, zenoh-backend-fs.
{
  mode: "router",

  // Listen for sensors, the catalog, and GUIs. Adjust to your network.
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },

  // MUTABLE-KEY CORRECTNESS. State docs are last-writer-wins mutable keys
  // (RFC 04 §1): a sensor re-publishes its health/evidence on every refresh,
  // the catalog re-publishes each HostEntity (and DELETE-tombstones retired
  // ones). For the storage to keep the *newest* state — and never let a late,
  // duplicated, or replayed sample clobber newer state — every sample must
  // carry a timestamp. A router timestamps by default; set explicitly so this
  // config stays correct even run on a peer/client. `enabled: true`
  // re-timestamps any un-timestamped sample; `drop_future_timestamp: false`
  // re-timestamps (rather than drops) samples from a clock-skewed publisher.
  timestamping: {
    enabled: true,
    drop_future_timestamp: false,
  },

  plugins_loading: { enabled: true },

  plugins: {
    storage_manager: {
      volumes: {
        // Persist docs to disk so they survive a router restart.
        // ZENOH_BACKEND_FS_ROOT (env) sets the base directory the relative
        // `dir`s below hang under. `backend: "fs"` is implied by the name.
        fs: {},
      },
      storages: {
        // Current truth of the fleet: every host's state class — health,
        // errors, alerts, evidence, expectations, stream/device docs. LWW per
        // key; DELETE tombstones retire a doc.
        "zensight-latest": {
          key_expr: "zensight/@v1/*/state/**",
          strip_prefix: "zensight/@v1",
          volume: { id: "fs", dir: "latest" },
          // Tombstone lifetime (RFC 09 §2.3): prune storage metadata —
          // including deletion tombstones — after 24 h. Must be ≥ the longest
          // registry ttl_s among mutable state docs, else a slow replica may
          // resurrect a retired key.
          garbage_collection: { period: 3600, lifespan: 86400 },
        },
        // The catalog service origin: entity/alias docs, claims, pdns. Named
        // explicitly — the `*` in the selector above cannot match `@catalog`.
        "zensight-catalog": {
          key_expr: "zensight/@v1/@catalog/state/**",
          strip_prefix: "zensight/@v1/@catalog",
          volume: { id: "fs", dir: "catalog" },
          garbage_collection: { period: 3600, lifespan: 86400 },
        },
      },
    },
  },
}
