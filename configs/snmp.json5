{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.
                      // "client", "peer", or "router"
    connect: [],                       // Endpoints to connect to (for client mode)
    // listen: ["tcp/0.0.0.0:7448"],   // Endpoints to listen on (for peer/router)
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
    },
  },

  // Serialization format for telemetry
  serialization: "cbor",               // "json" or "cbor"

  // SNMP sensor settings
  snmp: {

    // Override the agent-host source id (default: the local hostname).
    // source: "agent-host-01",

    // SNMP trap receiver (optional)
    // Subnet discovery (#541): OPT-IN, propose-only (state/snmp/discovery
    // doc; nothing is auto-added). No block = no scanning, ever.
    // discovery: { subnets: ["192.168.1.0/24"], credentials: ["readonly-v2c"] },

    // Resilience (#539): defaults shown — backoff to 10x, probe-only after
    // 3 dead cycles, 10% scheduling jitter.
    // resilience: { backoff_cap: 10, breaker_after: 3, jitter_percent: 10 },

    // Named credential sets (#538): one place to rotate. Values accept
    // "${ENV_VAR}" and "file:/path" secret indirection everywhere.
    // credentials: {
    //   "readonly-v2c": { community: "file:/run/credentials/snmp/community" },
    // },

    // Traps (#535): durable events + alert mapping. communities/users filter
    // senders; builtin_rules maps linkDown/linkUp to alerts out of the box.
    trap_listener: {
      enabled: false,
      bind: "0.0.0.0:162",
      // Where the SNMPv3 authoritative engine identity + boots counter live
      // (#650). Unset = the systemd StateDirectory / XDG state default. With
      // no durable location at all the receiver falls back to a per-start
      // identity, and every v3 inform sender re-handshakes after a restart.
      // engine_state_path: "/var/lib/zensight-snmp/snmp-trap-engine.json",
    },

    // v1/v2c OPT-IN (#825). A community string is a CLEARTEXT credential on
    // the wire — anyone on the path reads it and replays it (netring even
    // ships a detector for exactly this pattern). The sensor therefore
    // REFUSES to start with a v1/v2c device configured unless this flag
    // says, explicitly, that you accept the cost. Prefer v3 authPriv below.
    // allow_insecure_versions: true,

    // Devices to poll. The example leads with SNMPv3 authPriv — in 2026
    // that is the shipped default, not the aspiration (#825). Secrets take
    // "${ENV_VAR}" and "file:/path" indirection everywhere.
    devices: [
      {
        name: "router01",              // Used in key expressions
        address: "192.168.1.1:161",    // SNMP agent address
        version: "v3",
        security: {
          username: "zensight-ro",
          auth_protocol: "SHA256",     // "MD5" | "SHA" | "SHA224".."SHA512"
          auth_password: "file:/run/credentials/snmp/router01.auth",
          priv_protocol: "AES",        // "DES" | "3DES" | "AES" | "AES192" | "AES256"
                                       // | "AES192-REEDER" | "AES256-REEDER" (Cisco)
          priv_password: "file:/run/credentials/snmp/router01.priv",
        },
        poll_interval_secs: 30,        // Polling interval

        // Individual OIDs to poll with GET
        oids: [
          "1.3.6.1.2.1.1.1.0",         // sysDescr
          "1.3.6.1.2.1.1.3.0",         // sysUpTime
          "1.3.6.1.2.1.1.5.0",         // sysName
        ],

        // OID subtrees to poll with WALK (GETBULK on v2c/v3, GETNEXT on v1)
        walks: [
          "1.3.6.1.2.1.2.2.1",         // ifTable
        ],

        // Transport tuning (all optional)
        // timeout_secs: 5,             // per-request timeout, per attempt
        // retries: 2,                  // retransmissions after a timeout
        // max_repetitions: 20,         // GETBULK rows per round-trip (v2c/v3)

        // PER-DEVICE PDU BUDGET (#825). An SNMP sensor's characteristic
        // failure is hammering a device weaker than itself — an eight-year-old
        // switch CPU, or a UPS management card that reboots under load. One
        // device's tolerance says nothing about another's, so this is declared
        // HERE rather than once for the sensor.
        //
        // Absent = no ceiling, which is what every deployment before #825 had.
        // Set it on anything older or smaller than the machine polling it.
        //
        // A GET costs one token, charged before it is issued. A WALK is
        // charged AFTER it completes, from the rows it really returned
        // (ceil(rows / max_repetitions) + 1 for GETBULK) — how many PDUs a
        // walk takes is not knowable before the table is read, and estimating
        // it would make this number mean something other than what it says.
        //
        // Over budget the poller WAITS. It never drops a poll: a sensor that
        // skips work to stay under budget has traded the device's health for
        // a gap in its own telemetry.
        // max_pdus_per_sec: 20,        // token bucket; burst = one second's worth
        // max_concurrent: 2,           // outstanding operations against THIS device
                                        // (a walk holds its slot for its whole run)
      },
      // A legacy v1/v2c device — needs `allow_insecure_versions: true`
      // above, and the comment there says what that costs.
      //
      // A UPS is the usual reason to still be running v2c: a network
      // management card old enough to be under a UPS is often too old for v3.
      // `profile: "ups"` polls RFC 1628 (#955) and gives the `ups_*` rules
      // something to read — WITHOUT it the rules see nothing and fire nothing,
      // which is the design: a switch must not pay for the UPS tree.
      // {
      //   name: "legacy-ups",
      //   address: "192.168.1.2:161",
      //   community: "${SNMP_LEGACY_COMMUNITY}",
      //   version: "v2c",
      //   poll_interval_secs: 60,
      //   profile: "ups",
      //   alerts: {
      //     // A per-device block REPLACES the global one, field for field.
      //     // The runtime floor is a site decision: this UPS's, not the
      //     // fleet's. There is no default, and that is deliberate — a number
      //     // invented here would page every small UPS you own.
      //     ups_runtime_low: { enabled: true, minutes: 10 },
      //     ups_load_high:   { enabled: true, percent: 85 },
      //   },
      // },

      // A switched rack PDU. `pdu-apc`, `pdu-eaton` and `pdu-raritan` map
      // three vendor trees onto ONE set of metric names, so a rule and a
      // dashboard do not have to know which brand answered. `expect_on` is
      // the outlet ids that must read on — the table index as the device
      // reports it, which is `"3"` on an APC or a Raritan and `"1.3"` on an
      // Eaton, whose outlet tables are indexed by unit AND outlet. Empty
      // (the default) fires nothing: which outlets matter is site knowledge.
      // {
      //   name: "rack-pdu-a",
      //   address: "192.168.1.3:161",
      //   version: "v3",
      //   credentials: "readonly",
      //   poll_interval_secs: 60,
      //   profile: "pdu-apc",
      //   alerts: {
      //     pdu_outlet_off: { enabled: true, expect_on: ["1", "2", "5"] },
      //     pdu_overload:   { enabled: true, percent: 80 },
      //   },
      // },

      // A NAS appliance. `nas-synology`, `nas-qnap` and `nas-truenas` each
      // EXTEND `host-resources`, so hrStorage capacity keeps working even if
      // the vendor MIB is off — and the vendor tree adds the array and disk
      // health hrStorage has no concept of.
      // {
      //   name: "nas-01",
      //   address: "192.168.1.4:161",
      //   version: "v3",
      //   credentials: "readonly",
      //   poll_interval_secs: 120,
      //   profile: "nas-synology",
      //   alerts: {
      //     nas_array_degraded: { enabled: true },
      //     nas_disk_failed:    { enabled: true },
      //     nas_volume_full:    { enabled: true, percent: 85 },
      //   },
      // },
    ],

    // Standard SMI MIB directories (#532): drop vendor .mib files in and their
    // OIDs resolve by name; enums decode onto the `enum` label; UNITS apply.
    // mib: { dirs: ["/usr/share/snmp/mibs"] },

    // Observed-device identity evidence (#537), on by default: polled devices
    // reach the correlator's entity catalog (sysName, vendor, MACs, IPs).
    // evidence: { enabled: true, refresh_cycles: 10 },

    // Device profiles (#531): curated OID sets matched by sysObjectID. On by
    // default — a device with only name+address gets system + interface
    // metrics from the shipped profiles; pin more via devices[].profile.
    // profiles: {
    //   enabled: true,
    //   dirs: ["/etc/zensight/snmp-profiles"],  // user profiles (*.toml)
    // },

    // Joined per-device InterfaceTable state doc (#529), on by default.
    // publish_interfaces: true,

    // Threshold alerting (#528) — on by default with these values; every rule
    // is individually disableable, and a device can carry its own `alerts`
    // block to replace this one.
    // alerts: {
    //   enabled: true,
    //   for_secs: 0,                   // continuous-violation debounce
    //   unreachable: { enabled: true, cycles: 3 },
    //   interface_down: { enabled: true },
    //   interface_errors: { enabled: true, per_sec: 1.0 },
    //   utilization: { enabled: true, percent: 90.0 },
    //   reboot: { enabled: true, hold_secs: 300 },
    //   storage: { enabled: true, percent: 90.0 },    // needs an hrStorage walk
    //   processor: { enabled: true, percent: 90.0 },  // needs an hrProcessorLoad walk
    //
    //   // UPS and PDU (#955). All six read what the `ups` / `pdu-*` profiles
    //   // walk, so a device with neither profile produces nothing for them
    //   // and they reconcile empty every sweep — which is why they can be on
    //   // by default without costing a switch anything.
    //   //
    //   // The two that take a NUMBER have no default, and that is the rule
    //   // rather than an omission: a five-minute UPS under a switch and a
    //   // sixty-minute one under a rack have different answers, and "80%
    //   // loaded" is a property of how a site sized its power. Unset means
    //   // the rule never fires. Both migrate to the shared thresholds
    //   // vocabulary when #931 lands.
    //   ups_on_battery:  { enabled: true },   // upsOutputSource != normal(3)
    //   ups_battery_low: { enabled: true },   // upsBatteryStatus low(3)/depleted(4)
    //   ups_runtime_low: { enabled: true },   // + minutes: 10
    //   ups_load_high:   { enabled: true },   // + percent: 85
    //   pdu_outlet_off:  { enabled: true },   // + expect_on: ["1", "2"]
    //   pdu_overload:    { enabled: true },   // + percent: 80 (an APC also
    //                                         //   reports its OWN verdict,
    //                                         //   which wins where it exists)
    //
    //   // NAS appliances (#960), through the `nas-*` profiles. The client
    //   // side of a NAS is covered by hostspec/sysinfo/probe already; these
    //   // read the box. `nas_volume_full` is NOT `storage_usage`: hrStorage
    //   // lists mounted filesystems, and a pool at 95% under a half-empty
    //   // filesystem is exactly what it cannot see.
    //   nas_array_degraded: { enabled: true },
    //   nas_disk_failed:    { enabled: true },
    //   nas_volume_full:    { enabled: true },  // + percent: 85
    // },

    // ── Gated PDU outlet control (#956, SYS-SUP-003) ─────────────────────
    //
    // The FIRST write surface outside the systemd sensor, and it is a bigger
    // step than restarting a unit: a monitor that can CUT POWER is a
    // different threat model — the sentence the pve and bmc sensors use to
    // justify having no action surface at all. It is off, and the whole block
    // below is commented out, because a default deployment must not be able
    // to act.
    //
    // FOUR independent things must be true before an outlet cycles, and each
    // refusal names which one refused:
    //
    //   1. actions.enabled          — the master switch, default false
    //   2. actions.allow_outlets    — <device>/<outlet> globs, default EMPTY,
    //                                 which rejects everything even with the
    //                                 switch on. There is no `allow_all`: a
    //                                 wildcard you typed is a decision, a
    //                                 wildcard a default provided is an
    //                                 accident.
    //   3. actions.credentials      — a SEPARATE write credential set. Startup
    //                                 refuses `enabled` without one: a read
    //                                 community that can reach a SET is a
    //                                 control credential nobody granted. A
    //                                 v1/v2c community here also needs
    //                                 allow_insecure_versions, because a
    //                                 cleartext string that can cut power is
    //                                 a different proposition from one that
    //                                 reads a counter.
    //   4. devices[].profile        — the device must be pinned to a PDU
    //                                 profile whose CONTROL OIDs this build
    //                                 verified against the vendor MIB.
    //                                 Currently `pdu-apc` only: pdu-eaton and
    //                                 pdu-raritan are read-only, because
    //                                 guessing a control OID sends a write to
    //                                 a machine.
    //
    // WHAT THIS DOES NOT GIVE YOU. There is no polkit here — a PDU speaks
    // SNMP, and there is no local policy engine between us and it — and the
    // bus caller is anonymous. Every attempt, executed or refused, reaches
    // the host's audit subsystem (#957), which makes it AUDITABLE and not
    // ATTRIBUTABLE. Until a caller identity exists (Zenoh mTLS + ACL), the
    // honest sentence is: anyone who can reach the bus, and whose target is
    // on the allowlist, can cycle that outlet.
    //
    // actions: {
    //   enabled: true,
    //   allow_outlets: ["pdu-a/3", "pdu-a/4"],   // NOT ["*"] unless you mean it
    //   credentials: "pdu-write",                // a set defined above, v3 authPriv
    //   history_capacity: 64,                    // the @rpc/snmp/actions ring
    // },

    // Predefined OID groups (reusable across devices)
    oid_groups: {
      system_info: {
        oids: [
          "1.3.6.1.2.1.1.1.0",         // sysDescr
          "1.3.6.1.2.1.1.3.0",         // sysUpTime
          "1.3.6.1.2.1.1.5.0",         // sysName
          "1.3.6.1.2.1.1.6.0",         // sysLocation
          "1.3.6.1.2.1.1.7.0",         // sysServices
        ],
        walks: [],
      },
      network_interfaces: {
        oids: [],
        walks: [
          "1.3.6.1.2.1.2.2.1",         // ifTable
        ],
      },
    },

    // OID to human-readable name mapping
    // Use {index} placeholder for table indices
    // Names must be chunk-grammar-valid: lowercase alnum + `._-` per `/`
    // chunk (#559). These match the shipped profiles' convention.
    oid_names: {
      "1.3.6.1.2.1.1.1.0": "system/descr",
      "1.3.6.1.2.1.1.3.0": "system/uptime",
      "1.3.6.1.2.1.1.4.0": "system/contact",
      "1.3.6.1.2.1.1.5.0": "system/name",
      "1.3.6.1.2.1.1.6.0": "system/location",
      "1.3.6.1.2.1.1.7.0": "system/services",

      // Interface table columns
      "1.3.6.1.2.1.2.2.1.1": "if/{index}/index",
      "1.3.6.1.2.1.2.2.1.2": "if/{index}/descr",
      "1.3.6.1.2.1.2.2.1.3": "if/{index}/type",
      "1.3.6.1.2.1.2.2.1.5": "if/{index}/speed",
      "1.3.6.1.2.1.2.2.1.7": "if/{index}/admin_status",
      "1.3.6.1.2.1.2.2.1.8": "if/{index}/oper_status",
      "1.3.6.1.2.1.2.2.1.10": "if/{index}/in_octets",
      "1.3.6.1.2.1.2.2.1.11": "if/{index}/in_ucast_pkts",
      "1.3.6.1.2.1.2.2.1.13": "if/{index}/in_discards",
      "1.3.6.1.2.1.2.2.1.14": "if/{index}/in_errors",
      "1.3.6.1.2.1.2.2.1.16": "if/{index}/out_octets",
      "1.3.6.1.2.1.2.2.1.17": "if/{index}/out_ucast_pkts",
      "1.3.6.1.2.1.2.2.1.19": "if/{index}/out_discards",
      "1.3.6.1.2.1.2.2.1.20": "if/{index}/out_errors",
    },
  },

  // Logging
  logging: {
    level: "info",                     // "trace", "debug", "info", "warn", "error"
  },
}
