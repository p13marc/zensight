{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.
                    // "client", "peer", or "router"
    // connect: ["tcp/localhost:7447"], // Router endpoints (if client mode)
    serialization: "cbor",           // "json" or "cbor"
  },

  // Declared resource envelope (#811/#1091). `budget_rss_mb` arms two things
  // that do not exist without it: the `sensor-budget` alert at 80 % of this
  // number, and the shed ladder that tries to stay under it. A sensor with no
  // budget grows silently until the cgroup kills it — the 2026-08-17 sequence
  // `docs/ops/SIZING.md` is written about.
  //
  // A STARTING POINT, NOT A MEASUREMENT. 48 MiB is three quarters of this
  // unit's `MemoryMax=64M` — the same fraction the runner derives from a
  // cgroup when no budget is declared — so the ladder gets to shed before the
  // kernel gets to kill. Measure yours with `just fleet-sizing` and set it
  // from what you see; keep it BELOW `MemoryMax`.
  resources: {
    budget_rss_mb: 48,
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
    },
  },

  // Modbus sensor settings
  modbus: {

    // Override the agent-host source id (default: the local hostname).
    // source: "agent-host-01",

    // Devices to poll
    devices: [
      // Example: Modbus TCP device (PLC, power meter, etc.)
      {
        name: "plc01",
        connection: {
          type: "tcp",
          host: "192.168.1.10",
          port: 502,                 // Default Modbus TCP port
        },
        unit_id: 1,                  // Modbus slave ID (1-247)
        poll_interval_secs: 10,
        timeout_ms: 2000,
        retries: 3,

        // Inline register definitions.
        //
        // `count` is VALUES, not registers: an f32 is two registers, so
        // `count: 1` reads two and `count: 3` reads six and publishes at
        // address, address+2, address+4. This file used to say `count: 4` for a
        // single named f32, which read eight registers, decoded four floats and
        // published all four under one name — keeping the last (#1073). A
        // `name` with `count > 1` is now refused at startup.
        registers: [
          // Holding registers (read/write, 16-bit)
          {
            type: "holding",
            address: 0,             // spans 0-1
            count: 1,
            name: "temperature",
            data_type: "f32",        // 2 registers = 32-bit float
            scale: 1.0,
            unit: "°C",
          },
          {
            type: "holding",
            address: 2,             // spans 2-3
            count: 1,
            name: "pressure",
            data_type: "f32",
            scale: 0.01,             // Raw value * 0.01
            unit: "bar",
          },
          // Input registers (read-only, 16-bit)
          {
            type: "input",
            address: 0,
            count: 1,
            name: "status_word",
            data_type: "u16",
          },
        ],
      },

      // Example: Modbus RTU device (serial connection)
      {
        name: "sensor01",
        connection: {
          type: "rtu",
          port: "/dev/ttyUSB0",      // Serial port
          baud_rate: 9600,
          data_bits: 8,
          parity: "none",            // "none", "even", or "odd"
          stop_bits: 1,
        },
        unit_id: 5,
        poll_interval_secs: 5,
        register_group: "power_meters", // Reference to predefined group
      },
    ],

    // Predefined register groups (reusable across devices)
    register_groups: {
      power_meters: {
        registers: [
          {
            type: "holding",
            address: 0,
            count: 1,
            name: "voltage",
            data_type: "f32",
            unit: "V",
          },
          {
            type: "holding",
            address: 2,
            count: 1,
            name: "current",
            data_type: "f32",
            unit: "A",
          },
          {
            type: "holding",
            address: 4,
            count: 1,
            name: "power",
            data_type: "f32",
            unit: "W",
          },
          {
            type: "holding",
            address: 6,
            count: 1,
            name: "energy",
            data_type: "u32",
            scale: 0.001,            // Wh to kWh
            unit: "kWh",
          },
        ],
      },
      digital_io: {
        registers: [
          // A multi-value block carries no `name` — it would name all eight.
          // Per-address names come from `register_names` below; an address with
          // no entry is published under its own number.
          {
            type: "coil",
            address: 0,
            count: 8,
          },
          {
            type: "discrete",
            address: 0,
            count: 8,
          },
        ],
      },
    },

    // Optional: Human-readable names for register addresses
    // Format: "register_type:address": "name"
    // Per-ADDRESS names, for blocks that read more than one value. The address
    // advances by the value's register width, so consecutive f32 values are two
    // apart — `holding:100` and `holding:102`, never 100 and 101 (#1073).
    register_names: {
      "holding:100": "motor_speed",
      "holding:102": "motor_torque",
      "input:0": "running_status",
      "coil:0": "pump_enable",
      "coil:1": "valve_open",
    },
  },

  // Logging
  logging: {
    level: "info",                   // "trace", "debug", "info", "warn", "error"
  },

  // ───────────────────────────────────────────────────────────────────────
  // Threshold rules (#931) — numbers YOU chose, about metrics this sensor
  // publishes, evaluated on its own publish path and raised as alerts on
  // state/modbus/alert/*.
  //
  // Empty by default: this build ships no threshold that fires. The same set
  // is authorable fleet-wide on v1/@desired/state/<this-host>/modbus/
  // thresholds and per-host over @rpc/modbus/thresholds/set; whichever
  // wrote last is visible on state/modbus/applied/thresholds
  // (source: file | desired | rpc).
  //
  // This is a PROXY: `source` is the polled device, so a rule matches one
  // device with `labels: { source: "..." }` or all of them by leaving it out.
  // thresholds: {
  //   default_for_secs: 0,           // fire on the first violating sample
  //   default_recover_after_secs: 0, // resolve as soon as it is clear again
  //   rules: [
  //     {
  //       name: "tank-low",
  //       metric: "*/level",  // glob; `*` does not cross `/`
  //       // labels: { source: "plc-01" },  // all label globs must match
  //       op: "GreaterThan",            // GreaterThan | GreaterOrEqual | LessThan
  //                                     // | LessOrEqual | Equal | NotEqual
  //       value: 10.0,
  //       clear: 15.0,                 // must cross back through this to resolve
  //       for_secs: 60,                 // continuously violated for this long
  //       recover_after_secs: 120,      // continuously clear for this long
  //       severity: "warning",
  //       summary: "{metric} is {value} on {source}",
  //     },
  //   ],
  // },

  // `@desired` fleet reconcile (#931): the kill switch lives HERE, in file
  // config, so the mechanism that could misbehave is disarmable from outside
  // itself.
  // desired: {
  //   enabled: true,
  //   refresh_secs: 300,   // storage re-GET cadence (the primary path)
  // },
}
