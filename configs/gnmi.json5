// Example gNMI sensor configuration
{
  // Zenoh connection settings
  zenoh: {
    mode: "peer",
    // namespace: "my-deployment",  // OPTIONAL — the deployment base (#466), empty
                                    // by default (no session namespace; keys at the
                                    // bus root, Zenoh's own default). Set it — or
                                    // ZENSIGHT_ZENOH_NAMESPACE — to isolate this
                                    // deployment on shared Zenoh infrastructure: the
                                    // runtime prefixes it onto every key, strips it
                                    // on ingress, and filters other deployments' traffic.

    // connect: ["tcp/localhost:7447"],  // Uncomment for client mode
  },

  // On-demand artifact channel (@rpc artifact/request + @blob delivery) —
  // opt-in per kind. When enabled,
  // an operator can download a redacted tar.zst debug bundle (and, for
  // snapshot, an allowlisted directory) from the GUI. Bounded + rate-limited;
  // secrets are redacted.
  artifacts: {
    report: {
      enabled: false,        // set true to allow report downloads from this sensor
      max_bytes: 67108864,   // 64 MiB cap on the (uncompressed) bundle
      cooldown_secs: 30,     // min gap between generations
      ttl_secs: 600,         // how long a generated bundle stays downloadable
      chunk_size: 524288,    // 512 KiB transfer chunk (zblob validates: 64 KiB–4 MiB, 16 KiB-aligned)
      redact_extra: ["username"],
    },
  },

  // gNMI sensor settings
  gnmi: {

    // Override the agent-host source id (default: the local hostname).
    // source: "agent-host-01",

    // Serialization format: "json" or "cbor"
    serialization: "cbor",

    // Target devices to subscribe to
    targets: [
      {
        // Device name (used in key expressions)
        name: "router01",

        // gRPC endpoint
        address: "192.168.1.1:9339",

        // Authentication (optional)
        credentials: {
          username: "admin",
          password: "admin",
        },

        // TLS settings (optional)
        tls: {
          enabled: false,
          skip_verify: false,
          // ca_cert: "/path/to/ca.crt",
          // client_cert: "/path/to/client.crt",
          // client_key: "/path/to/client.key",
        },

        // gNMI encoding: JSON, JSON_IETF, PROTO, ASCII
        encoding: "JSON_IETF",

        // Subscription paths
        subscriptions: [
          {
            // OpenConfig interface counters
            path: "/interfaces/interface/state/counters",
            mode: "SAMPLE",
            sample_interval_ms: 10000,  // 10 seconds
          },
          {
            // Interface operational state
            path: "/interfaces/interface/state/oper-status",
            mode: "ON_CHANGE",
          },
          {
            // System information
            path: "/system/state",
            mode: "SAMPLE",
            sample_interval_ms: 60000,  // 1 minute
          },
        ],
      },

      // Example: Another device with different paths
      // {
      //   name: "switch01",
      //   address: "192.168.1.2:9339",
      //   credentials: {
      //     username: "admin",
      //     password: "admin",
      //   },
      //   encoding: "JSON",
      //   subscriptions: [
      //     {
      //       path: "/network-instances/network-instance/protocols/protocol/bgp/neighbors",
      //       mode: "ON_CHANGE",
      //     },
      //   ],
      // },
    ],
  },

  // Logging settings
  logging: {
    level: "info",  // trace, debug, info, warn, error
  },

  // ───────────────────────────────────────────────────────────────────────
  // Threshold rules (#931) — numbers YOU chose, about metrics this sensor
  // publishes, evaluated on its own publish path and raised as alerts on
  // state/gnmi/alert/*.
  //
  // Empty by default: this build ships no threshold that fires. The same set
  // is authorable fleet-wide on v1/@desired/state/<this-host>/gnmi/
  // thresholds and per-host over @rpc/gnmi/thresholds/set; whichever
  // wrote last is visible on state/gnmi/applied/thresholds
  // (source: file | desired | rpc).
  //
  // This is a PROXY: `source` is the polled device, so a rule matches one
  // device with `labels: { source: "..." }` or all of them by leaving it out.
  // thresholds: {
  //   default_for_secs: 0,           // fire on the first violating sample
  //   default_recover_after_secs: 0, // resolve as soon as it is clear again
  //   rules: [
  //     {
  //       name: "iface-errors",
  //       metric: "*/in-errors",  // glob; `*` does not cross `/`
  //       // labels: { source: "router-01" },  // all label globs must match
  //       op: "GreaterThan",            // GreaterThan | GreaterOrEqual | LessThan
  //                                     // | LessOrEqual | Equal | NotEqual
  //       value: 100.0,
  //       clear: 10.0,                 // must cross back through this to resolve
  //       for_secs: 60,                 // continuously violated for this long
  //       recover_after_secs: 120,      // continuously clear for this long
  //       severity: "warning",
  //       summary: "{metric} is {value} on {source}",
  //     },
  //   ],
  // },

  // `@desired` fleet reconcile (#931): the kill switch lives HERE, in file
  // config, so the mechanism that could misbehave is disarmable from outside
  // itself.
  // desired: {
  //   enabled: true,
  //   refresh_secs: 300,   // storage re-GET cadence (the primary path)
  // },
}
